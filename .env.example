# Kopier denne filen til `.env` og fyll inn dine egne verdier:
#
#   cp .env.example .env
#   chmod 600 .env
#
# `.env` er ignorert av git og skal aldri deles eller committes. Filen
# inneholder hemmeligheter og skal bare kunne leses av eieren (0600).
#
# Verdiene er uten anførselstegn fordi `docker run --env-file .env` ikke fjerner
# dem. Både dotenv og Docker Compose leser denne formen. Tomme verdier skrives
# som `NAVN=` (ikke `NAVN=""`).

# ---------------------------------------------------------------------------
# Database (påkrevd)
# ---------------------------------------------------------------------------
# Krever PostgreSQL 15 eller nyere. Dette er tilkoblingen appen bruker.
# Passord med spesialtegn (#, /, ?, @, :, %) må URL-kodes her. Eksempel:
# passordet `Test#123` skrives som `Test%23123`. POSTGRES_PASSWORD skal
# fortsatt være det rå passordet.
DATABASE_URL=postgresql://admin:bytt-meg@localhost:5432/fsm_db?schema=public

# Rolle-separasjon i Docker Compose. Runtime bruker en DML-rolle og
# migrasjonene en DDL-rolle. Uten disse brukes POSTGRES_USER, men i produksjon
# nekter /api/ready å bli grønn når runtime-rollen kan endre skjema.
# Opprett rollene med scripts/provision-db-roles.sh. Se «Databaseroller» i
# docs/OPERATIONS.md.
# DATABASE_RUNTIME_URL=postgresql://fsm_app:bytt-meg@postgres:5432/fsm_db?schema=public
# DATABASE_MIGRATION_URL=postgresql://fsm_migrator:bytt-meg@postgres:5432/fsm_db?schema=public
# Eksisterende installasjoner som bevisst fortsatt bruker superbruker:
# ALLOW_DB_DDL_ROLE=true

# ---------------------------------------------------------------------------
# Moduler (valgfritt)
# ---------------------------------------------------------------------------
# Første oppstart uten modulrader bruker dette preset. `full` (standard) slår på
# alle leverte moduler, også for eksisterende installasjoner som oppgraderer.
# `core` gir en kjerne-only installasjon (auth, brukere, avdelinger, kunder,
# oppdrag, arbeidsdager/tid, revisjon og innstillinger). Etter første oppstart
# er Innstillinger → Moduler kilden til sannhet. Se docs/MODULES.md.
# MODULE_PRESET=full

# ---------------------------------------------------------------------------
# Autentisering (påkrevd)
# ---------------------------------------------------------------------------
# Lag en tilfeldig nøkkel, for eksempel med:
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# Adressen appen nås på. I produksjon MÅ denne settes, og den må være https.
# La den stå utkommentert i lokal utvikling, da utledes verten fra forespørselen
# og innlogging virker både på localhost og på LAN-IP.
# I produksjon er både NEXTAUTH_URL og APP_URL påkrevd og MÅ være https://.
# Appen nekter å starte i produksjon hvis NEXTAUTH_URL ikke er https://.
# NEXTAUTH_URL=https://fsm.example.com

# Offentlig adresse brukt til absolutte URL-er (PDF-bilder) og same-origin-sjekk.
# Påkrevd i docker-compose.prod.yml.
# APP_URL=https://fsm.example.com

# Gjør at appen kan kjøre bak en proxy eller i en container.
AUTH_TRUST_HOST=true

# Stole på x-forwarded-proto og X-Forwarded-For fra reverse proxy. Sett true
# bare når proxyen overskriver headerne og appen ikke er direkte eksponert.
# TRUST_PROXY_HOPS er antallet betrodde proxyer (1 ved én Caddy/nginx).
# Produksjon nekter å starte med TRUST_PROXY=true uten eksplisitt hoppantall.
TRUST_PROXY=false
# TRUST_PROXY_HOPS=1

# Beskyttet driftsendepunkt /api/metrics. Uten denne svarer ruten 503.
# Lag en tilfeldig verdi, f.eks. `openssl rand -base64 32`.
# METRICS_SECRET=

# Loggnivå: debug, info, warn eller error (standard: info).
LOG_LEVEL=info

# Påkrevd to-trinns verifisering for utvalgte roller. Tom = valgfritt.
# Anbefalt i produksjon: ADMIN,OFFICE. Brukere uten 2FA sendes til
# /logg-inn/2fa/oppsett og får ingen sesjon før oppsettet er fullført.
# REQUIRE_2FA_ROLES=ADMIN,OFFICE

# ---------------------------------------------------------------------------
# API-nøkler og opplasting (valgfritt)
# ---------------------------------------------------------------------------
# Standard levetid når en API-nøkkel opprettes uten utløpsdato, og hard
# maksgrense. Begge er i dager.
# API_KEY_DEFAULT_LIFETIME_DAYS=90
# API_KEY_MAX_LIFETIME_DAYS=365

# Kvoter for opplasting. Brukerkvoten gjelder rullerende 24 timer; kundekvoten
# er samlet lagringsbruk per kunde. Verdiene er i megabyte.
# UPLOAD_QUOTA_USER_MB=2048
# UPLOAD_QUOTA_CUSTOMER_MB=10240

# Sti til qpdf-binæren. Standard er `qpdf` fra PATH (installeres i Docker).
# QPDF_PATH=/usr/bin/qpdf

# ---------------------------------------------------------------------------
# Offline (valgfritt)
# ---------------------------------------------------------------------------
# Maks alder i dager for lokale rapportkladder i nettleseren (standard: 7,
# tilsvarer OFFLINE_DRAFT_MAX_AGE_DAYS i src/lib/offline/db.ts). Eldre kladder
# skjules og ryddes, men usendte outbox-oppføringer beholdes og vises som
# feilede til brukeren prøver igjen eller forkaster dem bevisst. Verdien brukes
# i klienten og bakes inn ved bygg, så den må settes på nytt ved nytt image.
# NEXT_PUBLIC_OFFLINE_DRAFT_MAX_AGE_DAYS=7

# ---------------------------------------------------------------------------
# E-post (valgfritt)
# ---------------------------------------------------------------------------
# Brukes til invitasjoner og tilbakestilling av passord. Uten disse viser appen
# en lenke som kan deles manuelt i stedet.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---------------------------------------------------------------------------
# Docker Compose (valgfritt)
# ---------------------------------------------------------------------------
# Brukes av docker-compose.yml. Passordet bør være langt og tilfeldig.
POSTGRES_USER=admin
POSTGRES_DB=fsm_db
POSTGRES_PASSWORD=

# Opprett administrator automatisk ved første oppstart mot en tom database.
SEED_DATABASE=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# Ferdigbygd image for produksjon (docker-compose.prod.yml). PÅKREVD der, og
# skal peke på en publisert versjon eller et digest – ikke `latest`. Bruk samme
# verdi som release-taggen, f.eks. v0.8.9:
# APP_IMAGE=ghcr.io/eroticd/fsm-platform:v0.8.9
#
# Enda tryggere: pinn til digest fra GHCR. Se docs/OPERATIONS.md.
# APP_IMAGE=ghcr.io/eroticd/fsm-platform@sha256:<digest>
#
# Postgres-image for produksjon. Compose standard er en konkret 15.x-minor
# (postgres:15.13). Overstyr bare bevisst, og pinn gjerne til digest.
# POSTGRES_IMAGE=postgres:15.13
# POSTGRES_IMAGE=postgres:15.13@sha256:<digest>

# Registrer metadata for eldre opplastinger ved oppstart (idempotent). Kan slås
# av når backfill er kjørt én gang.
# BACKFILL_UPLOADS=true

# Produksjonssperre for migrasjoner (standard false). Sett true når du vil at
# appen skal nekte å migrere uten en bekreftet backup:
#   ./scripts/backup.sh && ./scripts/restore-test.sh
#   BACKUP_CONFIRMED=true docker compose -f docker-compose.prod.yml up -d
# REQUIRE_BACKUP_BEFORE_MIGRATE=true
# BACKUP_CONFIRMED=false

# Backup-kryptering. Med NODE_ENV=production (eller
# REQUIRE_BACKUP_ENCRYPTION=true) nekter scripts/backup.sh å kjøre uten en
# age-mottaker. Lokal utvikling kan fortsatt ta ukryptert backup.
# BACKUP_AGE_RECIPIENT=age1...
# REQUIRE_BACKUP_ENCRYPTION=false

# Backupstatus for /api/metrics og freshness-proben. systemd-jobben skriver
# filen; appen leser den read-only via ./monitoring.
# BACKUP_STATUS_FILE=/app/monitoring/backup-status.json
# BACKUP_MAX_AGE_HOURS=26
# Krev at backup jobben også har en verifisert ekstern kopi.
# REQUIRE_REMOTE_BACKUP=true

# ---------------------------------------------------------------------------
# Opplasting (valgfritt)
# ---------------------------------------------------------------------------
# Mappen bilder og vedlegg lagres i. Standard er ./uploads.
# UPLOAD_DIR=

# Per-fil-grenser. Det finnes ingen per-bruker-kvote i appen; den totale
# diskbruken styres av opplastingsvolumet. Se «Disk, opplastinger og
# opprydding» i docs/OPERATIONS.md før du øker grensene.
# UPLOAD_MAX_IMAGE_MB=15
# UPLOAD_MAX_DOCUMENT_MB=50

# Mappe med OCR-språkdata (nor.traineddata og eng.traineddata). Docker-imaget
# setter denne selv. Uten den henter tesseract.js språkdata fra nettet.
# TESSDATA_DIR=

# ---------------------------------------------------------------------------
# Kundeoverføring (valgfritt, men anbefalt)
# ---------------------------------------------------------------------------
# HMAC-SHA256-signatur (delt hemmelighet). Minst 32 tegn. Sett samme nøkkel på
# kilde og mottaker. Gamle nøkler under rotasjon legges i ..._KEYS_PREVIOUS.
# CUSTOMER_TRANSFER_SIGNING_KEY=
# CUSTOMER_TRANSFER_SIGNING_KEY_ID=
# CUSTOMER_TRANSFER_SIGNING_KEYS_PREVIOUS=
#
# Asymmetrisk Ed25519-signatur. Privatnøkkelen ligger bare på kilden;
# mottakeren trenger bare den offentlige nøkkelen. PEM kan skrives med escaped
# \n. Gamle offentlige nøkler under rotasjon legges i ..._PUBLIC_KEYS_PREVIOUS
# (kommaseparert PEM eller JSON-array). Se docs/OPERATIONS.md.
# CUSTOMER_TRANSFER_ED25519_PRIVATE_KEY=
# CUSTOMER_TRANSFER_ED25519_PUBLIC_KEY=
# CUSTOMER_TRANSFER_ED25519_KEY_ID=
# CUSTOMER_TRANSFER_ED25519_PUBLIC_KEYS_PREVIOUS=
#
# hmac | ed25519 | both | any. Standard er any når begge algoritmene er
# konfigurert, ellers den ene konfigurerte. Sett true for å kreve signatur.
# CUSTOMER_TRANSFER_SIGNATURE_MODE=
# CUSTOMER_TRANSFER_REQUIRE_SIGNATURE=false

# ---------------------------------------------------------------------------
# Serviceavtaler (valgfritt)
# ---------------------------------------------------------------------------
# Appen oppretter automatisk oppdrag fra forfalte serviceavtaler og
# vedlikeholdsplaner, og sender garantivarsler. Jobben starter sammen med
# serveren og kjører hver 6. time. Sett til false for å slå den av (for
# eksempel i utvikling).
# RECURRING_SCHEDULER=true

# Automatisk opprydding av SLA-klokker uten aktiv avtale. Kjører i scheduleren
# og er på som standard. Intervall i timer (desimaltall er tillatt); sett
# SLA_CLEANUP_ENABLED=false når en ekstern prosess eier jobben.
# SLA_CLEANUP_ENABLED=true
# SLA_CLEANUP_INTERVAL_HOURS=6

# Hemmelighet for ekstern/manuell kjøring av jobben:
#   curl -H "Authorization: Bearer <CRON_SECRET>" \
#     https://fsm.example.com/api/cron/recurring
# Uten denne er ruten svart av (503).
# Kart: geokoding av arbeidsadresser via OpenStreetMap/Nominatim.
# Sett GEOCODE_ENABLED=false for å slå av eksterne geokodingskall.
GEOCODE_ENABLED=true

# Gjennomsnittsfart for ETA når live sporing er slått på. Avstanden er
# luftlinje × 1,35 (veifaktor) delt på denne farten. Standard 50 km/t.
# TRACKING_AVERAGE_SPEED_KMH=50

# Valgfri ruteleverandør (OSRM-kompatibel) for ruteplan og ETA. Uten
# OSRM_BASE_URL gjøres ingen nettverkskall; da brukes luftlinje × 1,35 og
# farten over. Leverandøren har 60 sekunders tidsavbrudd og faller tilbake til
# lokal beregning ved feil.
# ROUTING_PROVIDER=osrm
# OSRM_BASE_URL=https://osrm.example.com
# Tidsavbrudd for ruteleverandøren i millisekunder (1000–120000, standard 60000).
# ROUTING_TIMEOUT_MS=60000
# Identifiser appen mot Nominatim (e-post/URL er nyttig ved feilsøking).
# GEOCODE_USER_AGENT=FSM-platform/0.8.9 (drift@example.com)
# Tidsavbrudd per geokodingsleverandør i millisekunder (standard 3500).
# GEOCODE_TIMEOUT_MS=3500
# Fallback-rekkefølgen er Nominatim → Kartverket → Photon. Endre bare hvis du
# har egne, kompatible tjenester.
# GEOCODE_KARTVERKET_ENDPOINT=https://ws.geonorge.no/adresser/v1/sok
# GEOCODE_PHOTON_ENDPOINT=https://photon.komoot.io/api/

# CRON_SECRET=

# Valgfri hemmelighet for full /api/ready-diagnostikk. Faller tilbake til
# CRON_SECRET når den er tom.
# READY_SECRET=

# ---------------------------------------------------------------------------
# SMS (valgfritt)
# ---------------------------------------------------------------------------
# console = tørrkjøring uten nettverkskall (standard). Andre verdier:
# linkmobility | pswincom | twilio. Ingen leverandør-SDK brukes.
SMS_PROVIDER=console
SMS_SENDER_ID=FSM
# Hemmelighet for HMAC-signatur på innkommende webhook. Uten denne avvises
# leveringer (console godtas bare utenfor produksjon).
SMS_WEBHOOK_SECRET=
# Valgfri ekstra sperre for test/staging: kommaseparerte numre.
SMS_ALLOWLIST=
# Egen worker-bryter; PDF_JOB_WORKER påvirker ikke SMS-køen.
SMS_WORKER=true
# Påminnelsesworkeren (SMS/e-post før besøk). Kjører også når PDF-workeren er av.
REMINDER_WORKER=true
# Link Mobility
SMS_LINKMOBILITY_URL=
SMS_LINKMOBILITY_API_KEY=
SMS_LINKMOBILITY_SECRET=
# PSWinCom
SMS_PSWINCOM_URL=
SMS_PSWINCOM_USER=
SMS_PSWINCOM_PASSWORD=
SMS_PSWINCOM_SECRET=
# Twilio
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Betaling (PSP, valgfritt)
# ---------------------------------------------------------------------------
# Tom/none = av. Stripe eller Vipps. Uten både API-nøkkel og webhook-hemmelighet
# er integrasjonen en stille no-op. Se docs/PAYMENTS.md.
PAYMENTS_PROVIDER=
# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Vipps MobilePay
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
VIPPS_MERCHANT_SERIAL_NUMBER=
VIPPS_WEBHOOK_SECRET=
# apitest.vipps.no i test, api.vipps.no i produksjon.
VIPPS_BASE_URL=https://apitest.vipps.no
VIPPS_SYSTEM_NAME=fsm-platform
VIPPS_SYSTEM_VERSION=1.0.0

# ---------------------------------------------------------------------------
# Regnskap (valgfritt)
# ---------------------------------------------------------------------------
# fiken | tripletex | poweroffice | csv. Selve synken slås på i adminpanelet.
# Se docs/ACCOUNTING.md.
ACCOUNTING_PROVIDER=csv
# Fiken
FIKEN_TOKEN=
FIKEN_COMPANY_SLUG=
FIKEN_BANK_ACCOUNT=
FIKEN_PAYMENT_DEBIT_ACCOUNT=
FIKEN_PAYMENT_CREDIT_ACCOUNT=
# Tripletex
TRIPLETEX_TOKEN=
TRIPLETEX_PAYMENT_TYPE_ID=
TRIPLETEX_VAT_TYPE_ID=3
# PowerOffice Go
POWEROFFICE_TOKEN=
POWEROFFICE_CLIENT_ID=
POWEROFFICE_CLIENT_SECRET=
POWEROFFICE_PAYMENT_DEBIT_ACCOUNT_ID=
POWEROFFICE_PAYMENT_CREDIT_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# SSO (OIDC, valgfritt)
# ---------------------------------------------------------------------------
# Kommaseparerte sluger. Hver leverandør bruker SSO_<SLUG>_-variabler, der
# slugens store bokstaver og bindestrek erstattes med understrek. Redirect-URL
# i IdP-en er https://<NEXTAUTH_URL>/api/auth/callback/sso-<slug>.
# Passordinnlogging beholdes alltid som break-glass.
# SSO_PROVIDERS=entra,keycloak
# SSO_ENTRA_ENABLED=true
# SSO_ENTRA_DISPLAY_NAME=Microsoft Entra ID
# SSO_ENTRA_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# SSO_ENTRA_CLIENT_ID=
# SSO_ENTRA_CLIENT_SECRET=
# SSO_ENTRA_SCOPES=openid,email,profile
# SSO_ENTRA_ALLOWED_EMAIL_DOMAINS=example.no
# SSO_ENTRA_AUTO_PROVISION=false
# SSO_ENTRA_AUTO_PROVISION_ACTIVE=false
# SSO_ENTRA_DEFAULT_ROLE=USER
# SSO_ENTRA_DEFAULT_DEPARTMENT=Oslo
# SSO_ENTRA_GROUPS_CLAIM=groups
# SSO_ENTRA_GROUP_ROLE_MAP={"FSM-Office":"OFFICE","FSM-Technicians":"TECHNICIAN"}
# SSO_ENTRA_SYNC_ROLES=false

# ---------------------------------------------------------------------------
# SCIM 2.0 (valgfritt)
# ---------------------------------------------------------------------------
# SCIM-tokens opprettes i Innstillinger → SSO og SCIM, ikke her. Disse styrer
# levetid og feltmapping for provisjonering.
# SCIM_TOKEN_DEFAULT_LIFETIME_DAYS=365
# SCIM_TOKEN_MAX_LIFETIME_DAYS=730
# SCIM_ALLOWED_EMAIL_DOMAINS=example.no
# SCIM_DEFAULT_ROLE=USER
# SCIM_DEFAULT_DEPARTMENT=Oslo
# SCIM_ALLOW_ADMIN=false
# SCIM_GROUP_ROLE_MAP={"FSM-Office":"OFFICE","FSM-Technicians":"TECHNICIAN"}

# ---------------------------------------------------------------------------
# Pushvarsler (valgfritt)
# ---------------------------------------------------------------------------
# Alt er av når ingenting er satt: appen registrerer enheter, men ingen
# nettverkskall gjøres. Se docs/PUSH.md.
# FCM HTTP v1: lim inn hele tjenestekonto-JSON-en på én linje.
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...","client_email":"..."}
# APNs token-basert autentisering (p8). Nøkkelen kan inneholde \n eller være base64.
# APNS_KEY_P8=
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=no.example.fsm
# APNS_ENV=production
# PUSH_WORKER=true
