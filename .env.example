# Kopier denne filen til `.env` og fyll inn dine egne verdier:
#
#   cp .env.example .env
#
# `.env` er ignorert av git og skal aldri deles eller committes.
#
# Verdiene er uten anførselstegn fordi `docker run --env-file .env` ikke fjerner
# dem. Både dotenv og Docker Compose leser denne formen. Tomme verdier skrives
# som `NAVN=` (ikke `NAVN=""`).

# ---------------------------------------------------------------------------
# Database (påkrevd)
# ---------------------------------------------------------------------------
# Krever PostgreSQL 15 eller nyere. Dette er tilkoblingen appen bruker.
# Passord med spesialtegn (#, /, ?, @, :, %) må URL-kodes her. Eksempel:
# passordet `Test#123` skrives som `Test%23123`. POSTGRES_PASSWORD skal
# fortsatt være det rå passordet.
DATABASE_URL=postgresql://admin:bytt-meg@localhost:5432/fsm_db?schema=public

# ---------------------------------------------------------------------------
# Autentisering (påkrevd)
# ---------------------------------------------------------------------------
# Lag en tilfeldig nøkkel, for eksempel med:
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# Adressen appen nås på. I produksjon MÅ denne settes, og den må være https.
# La den stå utkommentert i lokal utvikling, da utledes verten fra forespørselen
# og innlogging virker både på localhost og på LAN-IP.
# NEXTAUTH_URL=https://fsm.example.com

# Gjør at appen kan kjøre bak en proxy eller i en container.
AUTH_TRUST_HOST=true

# ---------------------------------------------------------------------------
# E-post (valgfritt)
# ---------------------------------------------------------------------------
# Brukes til invitasjoner og tilbakestilling av passord. Uten disse viser appen
# en lenke som kan deles manuelt i stedet.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---------------------------------------------------------------------------
# Docker Compose (valgfritt)
# ---------------------------------------------------------------------------
# Brukes av docker-compose.yml. Passordet bør være langt og tilfeldig.
POSTGRES_USER=admin
POSTGRES_DB=fsm_db
POSTGRES_PASSWORD=

# Opprett administrator automatisk ved første oppstart mot en tom database.
SEED_DATABASE=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# Ferdigbygd image for produksjon (docker-compose.prod.yml). Sett til en
# spesifikk versjon, f.eks. ghcr.io/eroticd/fsm-platform:0.2.2.
# APP_IMAGE=ghcr.io/eroticd/fsm-platform:latest

# ---------------------------------------------------------------------------
# Opplasting (valgfritt)
# ---------------------------------------------------------------------------
# Mappen bilder og vedlegg lagres i. Standard er ./uploads.
# UPLOAD_DIR=

# Mappe med OCR-språkdata (nor.traineddata og eng.traineddata). Docker-imaget
# setter denne selv. Uten den henter tesseract.js språkdata fra nettet.
# TESSDATA_DIR=

# ---------------------------------------------------------------------------
# Serviceavtaler (valgfritt)
# ---------------------------------------------------------------------------
# Appen oppretter automatisk oppdrag fra forfalte serviceavtaler. Jobben
# starter sammen med serveren og kjører hver 6. time. Sett til false for å
# slå den av (for eksempel i utvikling).
# RECURRING_SCHEDULER=true

# Hemmelighet for ekstern/manuell kjøring av jobben:
#   curl -H "Authorization: Bearer <CRON_SECRET>" \
#     https://fsm.example.com/api/cron/recurring
# Uten denne er ruten svart av (503).
# CRON_SECRET=
