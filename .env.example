# Kopier denne filen til `.env` og fyll inn dine egne verdier:
#
#   cp .env.example .env
#
# `.env` er ignorert av git og skal aldri deles eller committes.
#
# Verdiene er uten anførselstegn fordi `docker run --env-file .env` ikke fjerner
# dem. Både dotenv og Docker Compose leser denne formen. Tomme verdier skrives
# som `NAVN=` (ikke `NAVN=""`).

# ---------------------------------------------------------------------------
# Database (påkrevd)
# ---------------------------------------------------------------------------
# Krever PostgreSQL 15 eller nyere. Dette er tilkoblingen appen bruker.
# Passord med spesialtegn (#, /, ?, @, :, %) må URL-kodes her. Eksempel:
# passordet `Test#123` skrives som `Test%23123`. POSTGRES_PASSWORD skal
# fortsatt være det rå passordet.
DATABASE_URL=postgresql://admin:bytt-meg@localhost:5432/fsm_db?schema=public

# ---------------------------------------------------------------------------
# Autentisering (påkrevd)
# ---------------------------------------------------------------------------
# Lag en tilfeldig nøkkel, for eksempel med:
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# Adressen appen nås på. I produksjon MÅ denne settes, og den må være https.
# La den stå utkommentert i lokal utvikling, da utledes verten fra forespørselen
# og innlogging virker både på localhost og på LAN-IP.
# I produksjon er både NEXTAUTH_URL og APP_URL påkrevd og MÅ være https://.
# Appen nekter å starte i produksjon hvis NEXTAUTH_URL ikke er https://.
# NEXTAUTH_URL=https://fsm.example.com

# Offentlig adresse brukt til absolutte URL-er (PDF-bilder) og same-origin-sjekk.
# Påkrevd i docker-compose.prod.yml.
# APP_URL=https://fsm.example.com

# Gjør at appen kan kjøre bak en proxy eller i en container.
AUTH_TRUST_HOST=true

# Stole på x-forwarded-proto fra reverse proxy. Sett true bare når proxyen
# overskriver headerne og appen ikke er direkte eksponert.
TRUST_PROXY=false

# Loggnivå: debug, info, warn eller error (standard: info).
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# E-post (valgfritt)
# ---------------------------------------------------------------------------
# Brukes til invitasjoner og tilbakestilling av passord. Uten disse viser appen
# en lenke som kan deles manuelt i stedet.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---------------------------------------------------------------------------
# Docker Compose (valgfritt)
# ---------------------------------------------------------------------------
# Brukes av docker-compose.yml. Passordet bør være langt og tilfeldig.
POSTGRES_USER=admin
POSTGRES_DB=fsm_db
POSTGRES_PASSWORD=

# Opprett administrator automatisk ved første oppstart mot en tom database.
SEED_DATABASE=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# Ferdigbygd image for produksjon (docker-compose.prod.yml). PÅKREVD der, og
# skal peke på en publisert versjon eller et digest – ikke `latest`. Bruk samme
# verdi som release-taggen, f.eks. 0.7.1:
# APP_IMAGE=ghcr.io/eroticd/fsm-platform:0.7.1
#
# Enda tryggere: pinn til digest fra GHCR. Se docs/OPERATIONS.md.
# APP_IMAGE=ghcr.io/eroticd/fsm-platform@sha256:<digest>
#
# Postgres-image for produksjon. Pinn til en konkret 15.x-minor i stedet for
# den rullende 15-taggen, f.eks. postgres:15.13 (sjekk nyeste 15.x først).
# POSTGRES_IMAGE=postgres:15.13

# Registrer metadata for eldre opplastinger ved oppstart (idempotent). Kan slås
# av når backfill er kjørt én gang.
# BACKFILL_UPLOADS=true

# Produksjonssperre for migrasjoner (standard false). Sett true når du vil at
# appen skal nekte å migrere uten en bekreftet backup:
#   ./scripts/backup.sh && ./scripts/restore-test.sh
#   BACKUP_CONFIRMED=true docker compose -f docker-compose.prod.yml up -d
# REQUIRE_BACKUP_BEFORE_MIGRATE=true
# BACKUP_CONFIRMED=false

# ---------------------------------------------------------------------------
# Opplasting (valgfritt)
# ---------------------------------------------------------------------------
# Mappen bilder og vedlegg lagres i. Standard er ./uploads.
# UPLOAD_DIR=

# Per-fil-grenser. Det finnes ingen per-bruker-kvote i appen; den totale
# diskbruken styres av opplastingsvolumet. Se «Disk, opplastinger og
# opprydding» i docs/OPERATIONS.md før du øker grensene.
# UPLOAD_MAX_IMAGE_MB=15
# UPLOAD_MAX_DOCUMENT_MB=50

# Mappe med OCR-språkdata (nor.traineddata og eng.traineddata). Docker-imaget
# setter denne selv. Uten den henter tesseract.js språkdata fra nettet.
# TESSDATA_DIR=

# ---------------------------------------------------------------------------
# Serviceavtaler (valgfritt)
# ---------------------------------------------------------------------------
# Appen oppretter automatisk oppdrag fra forfalte serviceavtaler. Jobben
# starter sammen med serveren og kjører hver 6. time. Sett til false for å
# slå den av (for eksempel i utvikling).
# RECURRING_SCHEDULER=true

# Hemmelighet for ekstern/manuell kjøring av jobben:
#   curl -H "Authorization: Bearer <CRON_SECRET>" \
#     https://fsm.example.com/api/cron/recurring
# Uten denne er ruten svart av (503).
# CRON_SECRET=

# Valgfri hemmelighet for full /api/ready-diagnostikk. Faller tilbake til
# CRON_SECRET når den er tom.
# READY_SECRET=
