{
  "name": "fsm-platform",
  "type": "module",
  "version": "0.5.2",
  "private": true,
  "license": "BUSL-1.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "seed": "node scripts/seed.mjs",
    "db:migrate": "node ./node_modules/prisma/build/index.js migrate deploy",
    "db:status": "node ./node_modules/prisma/build/index.js migrate status",
    "postinstall": "node ./node_modules/prisma/build/index.js generate",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.22",
    "@fullcalendar/daygrid": "^6.1.22",
    "@fullcalendar/interaction": "^6.1.22",
    "@fullcalendar/timegrid": "^6.1.22",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@react-pdf/renderer": "^4.9.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "mdast-util-from-markdown": "^2.1.0",
    "next": "16.4.2",
    "next-auth": "^4.24.15",
    "next-intl": "^4.14.9",
    "nodemailer": "^10.2.1",
    "otplib": "^13.5.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "nodemailer": "^10.2.1",
    "source-map-js": "^1.2.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-signature-canvas": "^1.0.7",
    "@vitest/coverage-v8": "^5.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
