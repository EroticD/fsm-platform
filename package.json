{
  "name": "fsm-platform",
  "type": "module",
  "version": "0.9.5",
  "private": true,
  "license": "BUSL-1.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:changed": "node scripts/test-changed.mjs",
    "test:changed:integration": "node scripts/test-changed.mjs --integration",
    "test:module": "node scripts/test-module.mjs",
    "test:mapping": "node --test scripts/tests/test-mapping.test.mjs",
    "seed": "node scripts/seed.mjs",
    "seed:e2e": "node scripts/seed-e2e.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "screenshots:all": "node scripts/capture-all-screenshots.mjs",
    "screenshots:manual": "node scripts/capture-manual-screenshots.mjs",
    "screenshots:verify": "node scripts/verify-screenshot-coverage.mjs",
    "brand:assets": "node scripts/generate-brand-assets.mjs",
    "db:migrate": "node ./node_modules/prisma/build/index.js migrate deploy",
    "db:status": "node ./node_modules/prisma/build/index.js migrate status",
    "db:drift": "node ./node_modules/prisma/build/index.js migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "postinstall": "node ./node_modules/prisma/build/index.js generate",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:i18n:strict": "node scripts/check-i18n.mjs --strict",
    "i18n:add": "node scripts/i18n-add.mjs",
    "audit:backfill": "tsx scripts/backfill-audit-chain.ts",
    "audit:verify": "tsx scripts/verify-audit-chain.ts",
    "compliance:evidence": "node scripts/compliance/collect-evidence.mjs",
    "compliance:links": "node scripts/compliance/check-doc-links.mjs",
    "transfer:encrypt": "tsx scripts/transfer-encrypt.ts",
    "transfer:decrypt": "tsx scripts/transfer-decrypt.ts",
    "transfer:reconcile": "tsx scripts/reconcile-transfers.ts",
    "storage:migrate": "tsx scripts/migrate-uploads-to-s3.ts",
    "visits:backfill:daily": "tsx scripts/backfill-daily-visits.ts",
    "sla:cleanup": "tsx scripts/cancel-uncontracted-sla.ts",
    "registry:check": "tsx scripts/check-customer-registry.ts",
    "repair:closed-work-orders": "tsx scripts/repair-closed-work-order-state.ts",
    "manual:build": "node scripts/build-manual.mjs",
    "manual:verify": "node scripts/verify-manual-screenshots.mjs",
    "manual:all": "npm run manual:verify && npm run manual:build",
    "i18n:unused": "node scripts/i18n-unused.mjs",
    "test:coverage": "vitest run --coverage",
    "test:lighthouse": "node scripts/lighthouse-a11y.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1167.0",
    "@node-saml/node-saml": "^5.2.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@react-pdf/renderer": "^4.9.0",
    "@xmldom/xmldom": "^0.8.15",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "fullcalendar": "^7.1.4",
    "ioredis": "^6.0.0",
    "leaflet": "^1.9.4",
    "mdast-util-from-markdown": "^2.1.0",
    "next": "^16.4.6",
    "next-auth": "^4.24.15",
    "next-intl": "^4.14.9",
    "nodemailer": "^10.2.1",
    "otplib": "^13.6.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sharp": "^0.35.5",
    "temporal-polyfill": "^1.0.7",
    "tesseract.js": "^7.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "nodemailer": "^10.2.1",
    "source-map-js": "^1.2.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/leaflet": "^1.9.22",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-signature-canvas": "^1.0.7",
    "@vitest/coverage-v8": "^5.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "lighthouse": "^13.6.0",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
