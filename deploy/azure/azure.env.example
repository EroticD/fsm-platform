# Mal for Azure-drift. Kopier til /etc/fsm/fsm.env på VM-en og fyll inn
# verdiene. Filen skal aldri committes, og skal være 0600 og eies av root:
#
#   sudo install -m 600 -o root -g root azure.env.example /etc/fsm/fsm.env
#
# I den anbefalte modellen skrives filen av deploy/azure/fsm-fetch-secrets.sh
# fra Azure Key Vault. Denne malen viser hvilke nøkler som må finnes.
#
# Passord med spesialtegn i DATABASE_URL må URL-kodes. Enklest er å bruke
# heksadesimale passord (0-9a-f), som ikke trenger koding.

# ---------------------------------------------------------------------------
# Image og domene (påkrevd)
# ---------------------------------------------------------------------------
# Pinn til en publisert release-tag eller et digest, aldri latest.
APP_IMAGE=ghcr.io/eroticd/fsm-platform:v0.9.3
CADDY_IMAGE=caddy:2.10-alpine
FSM_DOMAIN=fsm.example.no

# ---------------------------------------------------------------------------
# Database (påkrevd)
# ---------------------------------------------------------------------------
# Azure Database for PostgreSQL Flexible Server, privat VNet-tilgang.
# sslmode=verify-full validerer både kryptering og vertsnavn. Bruk require bare
# hvis CA-kjeden ikke kan valideres i imaget.
#
# Disse to overstyres av /etc/fsm/fsm.env når fsm-fetch-secrets.sh henter
# database-runtime-url og database-migration-url fra Key Vault. Plassholderne
# gjør at `docker compose config` kan valideres uten Azure.
DATABASE_URL=postgresql://fsm_app:REPLACE_ME@pg-fsm-prod.postgres.database.azure.com:5432/fsm_db?schema=public&sslmode=verify-full
DATABASE_MIGRATION_URL=postgresql://fsm_migrator:REPLACE_ME@pg-fsm-prod.postgres.database.azure.com:5432/fsm_db?schema=public&sslmode=verify-full

# Runtime-rollen skal ikke kunne DDL. La denne stå false i produksjon.
ALLOW_DB_DDL_ROLE=false

# ---------------------------------------------------------------------------
# Autentisering og URL-er (påkrevd)
# ---------------------------------------------------------------------------
NEXTAUTH_URL=https://fsm.example.no
APP_URL=https://fsm.example.no
# Åpne med: openssl rand -base64 32. Overstyres av /etc/fsm/fsm.env fra
# Key Vault-hemmeligheten nextauth-secret.
NEXTAUTH_SECRET=REPLACE_ME
# Ett hopp: Caddy. Økes bare hvis flere proxyer står foran appen.
TRUST_PROXY_HOPS=1
LOG_LEVEL=info

# Beskyttet /api/metrics. Uten verdi svarer ruten 503.
METRICS_SECRET=REPLACE_ME
# Valgfri hemmelighet for full /api/ready-diagnostikk.
READY_SECRET=REPLACE_ME
# Hemmelighet for /api/cron/recurring og andre cron-ruter.
CRON_SECRET=REPLACE_ME

# ---------------------------------------------------------------------------
# Sikkerhet og opplasting (anbefalt)
# ---------------------------------------------------------------------------
# Påkrevd to-trinns verifisering for privilegerte roller.
REQUIRE_2FA_ROLES=ADMIN,OFFICE
UPLOAD_MAX_IMAGE_MB=15
UPLOAD_MAX_DOCUMENT_MB=50
UPLOAD_QUOTA_USER_MB=2048
UPLOAD_QUOTA_CUSTOMER_MB=10240

# Delt lagring (valgfritt). Med lokal disk er UPLOAD_DIR et volum på VM-en.
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=eu-north-1
# S3_PREFIX=fsm
# S3_ENDPOINT=https://minio.example.no
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SERVER_SIDE_ENCRYPTION=AES256
# UPLOAD_TEMP_DIR=/tmp

# Redis for kø/cache/rate limits (valgfritt). Databasen er fallback.
# QUEUE_DRIVER=redis
# CACHE_DRIVER=redis
# RATE_LIMIT_DRIVER=redis
# REDIS_URL=rediss://:REPLACE_ME@redis.example.net:6380/0

# Maks DB-tilkoblinger per appprosess. Med N replikaer må
# N * DATABASE_POOL_MAX + margin være under serverens max_connections.
# DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Første oppstart (bare første gang)
# ---------------------------------------------------------------------------
# Sett true, start, og slå av igjen. Passordet må være sterkt og byttes etter
# første innlogging.
SEED_DATABASE=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator

# ---------------------------------------------------------------------------
# Backup og migreringssperre (anbefalt)
# ---------------------------------------------------------------------------
# Med true nekter oppstartsskriptet å migrere uten BACKUP_CONFIRMED=true.
REQUIRE_BACKUP_BEFORE_MIGRATE=false
BACKUP_CONFIRMED=false
BACKUP_STATUS_FILE=/app/monitoring/backup-status.json
BACKUP_MAX_AGE_HOURS=26

# ---------------------------------------------------------------------------
# E-post (valgfritt)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---------------------------------------------------------------------------
# SMS (valgfritt; console er tørrkjøring)
# ---------------------------------------------------------------------------
SMS_PROVIDER=console
SMS_SENDER_ID=FSM
SMS_WEBHOOK_SECRET=
SMS_ALLOWLIST=
SMS_WORKER=true
SMS_LINKMOBILITY_URL=
SMS_LINKMOBILITY_API_KEY=
SMS_LINKMOBILITY_SECRET=
SMS_PSWINCOM_URL=
SMS_PSWINCOM_USER=
SMS_PSWINCOM_PASSWORD=
SMS_PSWINCOM_SECRET=
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Øvrige valg (valgfritt)
# ---------------------------------------------------------------------------
RECURRING_SCHEDULER=true
GEOCODE_ENABLED=true
GEOCODE_USER_AGENT=FSM-platform/0.8.10 (drift@example.no)
GEOCODE_TIMEOUT_MS=2500
TRACKING_AVERAGE_SPEED_KMH=50

# Minne: hold heap under APP_MEM_LIMIT. Standard er 3 GB/1536 MB for en 8 GB VM.
APP_MEM_LIMIT=3g
NODE_OPTIONS=--max-old-space-size=1536
DB_WAIT_RETRIES=180
DB_WAIT_SECONDS=2

# Mappe for backupstatus som monteres read-only inn i appen. Standard er
# ../../monitoring relativt til denne Compose-filen.
# MONITORING_DIR=../../monitoring

# ---------------------------------------------------------------------------
# Bare for fsm-fetch-secrets.sh / systemd (ikke appen)
# ---------------------------------------------------------------------------
# Key Vault som hemmelighetene hentes fra. Må fylles inn.
KEY_VAULT_URL=https://kv-fsm-prod.vault.azure.net/
# GitHub-bruker for valgfri GHCR-innlogging. Selve tokenet ligger i Key Vault
# som «ghcr-token» og skrives aldri til env-filen.
GHCR_USER=
