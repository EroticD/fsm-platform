# Eksempel på Caddy foran FSM-plattformen. Bruk denne som utgangspunkt og
# erstatt domenet. Appen skal bare lytte på 127.0.0.1:3000.
#
# Viktig:
#   * X-Forwarded-* overskrives, ikke appendes. En klient kan dermed ikke
#     sende med sin egen X-Forwarded-For og påvirke rate-limit-nøkkelen.
#   * Body-grensen er 55 MB (50 MB PDF + multipart-overhead), litt over
#     appens egen grense, slik at appen kan svare med en tydelig 413.
#   * Kundeimport har en egen grense på 520 MiB, fordi appen tar imot ZIP opp
#     til 512 MiB (proxyClientMaxBodySize i next.config.ts).
#   * Lange tidsavbrudd for PDF/OCR og store opplastinger.
#
# I .env:
#   TRUST_PROXY=true
#   TRUST_PROXY_HOPS=1
#
# Står det flere proxyer foran appen, må TRUST_PROXY_HOPS økes og bare
# kantsonen skal overskrive X-Forwarded-For. Se deploy/proxy/README.md.

# Felles proxyoppsett, slik at de to handle-blokkene under ikke kan komme i
# utakt. Caddys `handle` er terminerende: bare én av dem kjører per forespørsel.
(fsm_proxy) {
	reverse_proxy 127.0.0.1:3000 {
		# Overskriv alle videresendingsheadere. Uten dette kan klienten
		# bestemme både IP og protokoll.
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}

		transport http {
			dial_timeout 5s
			response_header_timeout 300s
			read_timeout 300s
			write_timeout 300s
		}
	}
}

fsm.example.com {
	encode zstd gzip

	# Kundeimport: appen godtar ZIP opp til 512 MiB, og håndhever grensen selv.
	# Uten dette ville den globale 55 MB-grensen avvist en gyldig import før
	# appen fikk svart. 520MiB er binære megabyte (545 MB), altså 8 MiB over
	# appens grense, slik at det er appen som svarer med sin egen 413.
	# Merk: `MB` i Caddy er 10^6 byte, mens `MiB` er 2^20 – bruk MiB her.
	handle /api/innstillinger/kunder/import* {
		request_body {
			max_size 520MiB
		}
		import fsm_proxy
	}

	# Alt annet: litt over appens 50 MB-grense for PDF.
	handle {
		request_body {
			max_size 55MB
		}
		import fsm_proxy
	}

	# Sikkerhetsheadere. Appen setter flere selv, men proxyen kan legge til
	# HSTS og skjule serverversjonen.
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}
