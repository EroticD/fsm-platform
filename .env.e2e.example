# Miljøvariabler for E2E-tester og skjermbilder.
#
# Kopier til `.env.e2e.local` (ignorert av git) og last den inn i skallet:
#
#   cp .env.e2e.example .env.e2e.local
#   set -a && . ./.env.e2e.local && set +a
#
# Testene og skriptene bruker en egen, isolert database (`fsm_ui_e2e`).
# Alle kontoene og all data der er fiktive. Kjør aldri seed:e2e mot en
# produksjonsdatabase.

# ---------------------------------------------------------------------------
# Database (påkrevd)
# ---------------------------------------------------------------------------
# Samme bruker/passord som din lokale Postgres, men en egen database. Opprett
# den med `createdb fsm_ui_e2e` og kjør deretter migrasjonene mot den:
#   DATABASE_URL=postgresql://.../fsm_ui_e2e?schema=public npx prisma migrate deploy
DATABASE_URL=postgresql://admin:bytt-meg@localhost:5432/fsm_ui_e2e?schema=public

# ---------------------------------------------------------------------------
# Autentisering (påkrevd)
# ---------------------------------------------------------------------------
# Lag en egen nøkkel for E2E, for eksempel med:
#   openssl rand -base64 32
NEXTAUTH_SECRET=bytt-meg-med-openssl-rand-base64-32

# Appen kjøres på port 3100 under E2E og skjermbildefangst.
NEXTAUTH_URL=http://127.0.0.1:3100

# Gjør at appen kan kjøre bak en proxy eller i en container.
AUTH_TRUST_HOST=true

# ---------------------------------------------------------------------------
# E2E-kontoer (påkrevd for rolltestene)
# ---------------------------------------------------------------------------
# Opprettes av `npm run seed:e2e`. Alle er fiktive og lever bare i fsm_ui_e2e.
E2E_ADMIN_EMAIL=admin@example.test
E2E_ADMIN_PASSWORD=AdminTest123!

E2E_OFFICE_EMAIL=kontor@example.test
E2E_OFFICE_PASSWORD=OfficeTest123!

E2E_TECHNICIAN_EMAIL=montor@example.test
E2E_TECHNICIAN_PASSWORD=TechTest123!

E2E_CUSTOMER_EMAIL=kunde@example.test
E2E_CUSTOMER_PASSWORD=CustomerTest123!
