generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Tilkoblingsadressen settes i prisma.config.mjs (Prisma 7). Klienten får
  // den via driver-adapteren i src/lib/prisma.ts.
}

// Avdelingene avgjør hvilke oppdrag en ansatt kan se. Kunder, dokumenter og
// rapporter er felles for alle avdelinger, mens oppdrag er avdelingssperret.
model Department {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)
  /// Standardavdeling for kundebestillinger og nye oppdrag uten valgt avdeling.
  isDefault   Boolean @default(false)

  /// Live sporing av montør er av som standard. Avdelingen må eksplisitt slå
  /// dette på; se docs/DECISIONS.md (GDPR, D-5).
  trackingEnabled Boolean @default(false)

  // Kontaktinfo for avdelingen/lokasjonen. Vises i kundeportalen.
  phone      String?
  email      String?
  address    String?
  city       String?
  postalCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  workOrders         WorkOrder[]
  contracts          Contract[]
  customers          Customer[]
  slaPolicies        SlaPolicy[]
  businessHours      BusinessHours[]
  holidays           Holiday[]
  maintenancePlans   MaintenancePlan[]
  territories        Territory[]
  capacityPlans      CapacityPlan[]
  assignmentPolicies AssignmentPolicy[]
  messageThreads     MessageThread[]
  smsMessages        SmsMessage[]

  @@index([isActive])
}

// Roller kan opprettes og redigeres av administrator. Nøkkelen er stabil og
// brukes av koden for spesialroller som ADMIN, TECHNICIAN og CUSTOMER, mens
// visningsnavnet og rettighetene kan endres.
model Role {
  key         String   @id
  label       String   @unique
  description String?
  permissions String[] @default([])
  isSystem    Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@index([isSystem])
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  phone          String?
  emailVerified  DateTime?
  image          String?
  role           String    @default("TECHNICIAN")
  roleDefinition Role      @relation(fields: [role], references: [key], onUpdate: Cascade, onDelete: Restrict)

  password         String?
  resetToken       String?
  resetTokenExpiry DateTime?

  isTwoFactorEnabled      Boolean   @default(false)
  twoFactorSecret         String?
  // Når det pågående 2FA-oppsettet ble startet. Oppsett eldre enn 10 minutter
  // avvises, slik at en gammel hemmelighet ikke kan bekreftes senere.
  twoFactorSetupStartedAt DateTime?

  // Siste TOTP-tidssteg som ble godtatt. Neste verifisering må ligge etter
  // dette, ellers kan samme 30-sekundskode brukes om igjen.
  lastTotpTimeStep Int?

  // Konto må aktiveres manuelt av en administrator før innlogging er tillatt
  isActive Boolean @default(false)

  // Økes når økten skal ugyldiggjøres (passordbytte, rolleendring, 2FA-endring).
  // JWTs med eldre versjon avvises av getCurrentUser().
  sessionVersion Int @default(0)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  // Kundeportalbrukere kobles til en kontaktperson på kundekortet
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  /// Språket mottakeren skal få SMS og e-post på. Standard er norsk.
  locale String @default("nb")

  // Ansatte tilhører en avdeling. Kundeportalbrukere kan stå uten.
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  // Tilpassede rettigheter. Når permissionsCustomized er true overstyrer
  // permissions rollens rettigheter helt. Sletting er ikke en rettighet her;
  // det er alltid forbeholdt administrator.
  permissions           String[] @default([])
  permissionsCustomized Boolean  @default(false)

  workOrders WorkOrder[] @relation("WorkOrderTechnicians")

  // Kunder der denne brukeren er ansvarlig montør.
  responsibleCustomers Customer[] @relation("CustomerResponsibleTechnician")

  // Kladder for sjekklister brukeren har begynt å fylle ut.
  reportDrafts ReportDraft[]

  // Kalenderabonnement (iCal). Bare SHA-256-hashen lagres.
  calendarTokenHash       String?   @unique
  calendarTokenCreatedAt  DateTime?
  calendarTokenLastUsedAt DateTime?

  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  savedSearches           SavedSearch[]
  twoFactorRecoveryCodes  TwoFactorRecoveryCode[]
  apiKeys                 ApiKey[]

  // Meldinger skrevet av brukeren, og SMS-samtykke for ansatte.
  messageAuthors     Message[]
  channelPreferences ChannelPreference[]
  smsMessages        SmsMessage[]

  // Planlegging: visittildelinger, kompetanse, arbeidstid og fravær.
  visitAssignments VisitTechnician[]
  skills           UserSkill[]
  availability     UserAvailability[]
  absences         Absence[]
  bookingHolds     BookingHold[]      @relation("BookingHoldTechnician")

  // Målinger registrert av brukeren.
  meterReadings MeterReading[]

  // Kapasitetsplaner der brukeren er satt opp med en egen kapasitet.
  capacityPlans CapacityPlan[]

  // Posisjonsping under pågående visitt. Slettes etter 24 timer.
  visitLocationPings VisitLocationPing[]

  @@index([departmentId])
  @@index([role])
  @@index([resetToken])
  @@index([customerId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_name_trgm")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_email_trgm")
}

/// API-nøkkel for integrasjoner. Bare SHA-256-hashen lagres; klarteksttokenet
/// vises én gang ved opprettelse. Prefix er de første tegnene, slik at nøkkelen
/// kan gjenkjennes i grensesnittet uten å avsløre resten.
model ApiKey {
  id      String @id @default(cuid())
  name    String
  keyHash String @unique
  prefix  String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?

  @@index([userId])
  @@index([keyHash])
}

// Engangskoder for gjenoppretting av 2FA. Bare bcrypt-hashen lagres, og hver
// kode kan brukes nøyaktig én gang (usedAt settes ved innlogging).
model TwoFactorRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
}

model Customer {
  id             String   @id @default(cuid())
  name           String
  customerNumber String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  orgNumber      String?
  brandColor     String?
  logoUrl        String?

  address    String?
  postalCode String?
  city       String?
  phone      String?
  email      String?
  notes      String?

  /// Myk sletting: raden beholdes for historikk/revisjon.
  deletedAt DateTime?
  deletedBy String?

  // Valgfri tilhørighet: hvilken avdeling og eventuelt hvilken montør som er
  // ansvarlig for kunden. Brukes blant annet i kundeportalen for å vise riktig
  // lokasjon og direkte kontaktinfo.
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  responsibleTechnicianId String?
  responsibleTechnician   User?   @relation("CustomerResponsibleTechnician", fields: [responsibleTechnicianId], references: [id], onDelete: SetNull)

  products         Product[]
  contracts        Contract[]
  workOrder        WorkOrder[]
  bookingRequests  BookingRequest[]
  sites            CustomerSite[]
  bookingHolds     BookingHold[]
  contacts         Contact[]
  comments         Comment[]
  attachments      CustomerAttachment[]
  maintenancePlans MaintenancePlan[]
  messageThreads   MessageThread[]

  users User[]

  @@index([departmentId])
  @@index([responsibleTechnicianId])
  @@index([email])
  @@index([orgNumber])
  @@index([name])
  @@index([customerNumber])
  @@index([deletedAt])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Customer_name_trgm")
  @@index([city(ops: raw("gin_trgm_ops"))], type: Gin, map: "Customer_city_trgm")
}

/// Kundens fysiske adresse eller anlegg som en bestilling gjelder. Kunden kan
/// ha flere steder, men kundeportalen bruker bare det primære stedet som
/// standardvalg. Adressen lagres som et snapshot på bestillingen.
model CustomerSite {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  address    String?
  postalCode String?
  city       String?
  latitude   Float?
  longitude  Float?
  isPrimary  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  bookingRequests BookingRequest[]
  bookingHolds    BookingHold[]
  workOrders      WorkOrder[]
  products        Product[]

  @@unique([customerId, name])
  @@index([customerId])
  @@index([customerId, isPrimary])
}

model Contact {
  id         String   @id @default(cuid())
  name       String
  email      String?
  phone      String?
  role       String?
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  workOrder WorkOrder[]
  comments  Comment[]
  users     User[]
  contracts Contract[]

  /// Språket kontaktpersonen skal få SMS på. Standard er norsk.
  locale             String              @default("nb")
  messageThreads     MessageThread[]
  smsMessages        SmsMessage[]
  channelPreferences ChannelPreference[]
  portalDelegation   PortalDelegation?

  @@index([customerId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Contact_name_trgm")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "Contact_email_trgm")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "Contact_phone_trgm")
}

/// Delegerte rettigheter for en kontaktperson som logger inn i kundeportalen.
/// En kontakt uten rad har full portaltilgang (bakoverkompatibelt); en rad med
/// `isActive = false` stenger portalen for den kontakten helt.
model PortalDelegation {
  id        String  @id @default(cuid())
  contactId String  @unique
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  canBook           Boolean @default(false)
  canViewDocuments  Boolean @default(false)
  canViewContracts  Boolean @default(false)
  canViewEquipment  Boolean @default(true)
  isActive          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([contactId, isActive])
}

/// Utstyrets driftstilstand. Retired er en historisk enhet som ikke lenger
/// skal få nye målinger eller vedlikeholdsplaner.
enum EquipmentStatus {
  ACTIVE
  OUT_OF_SERVICE
  RETIRED
}

/// Kategoritre for utstyr. Treet er enkelt å bygge ut (bygg → system → enhet),
/// men sykluser avvises av tjenestelaget, ikke bare av databasen.
model EquipmentCategory {
  id       String  @id @default(cuid())
  name     String
  parentId String?

  parent   EquipmentCategory?  @relation("EquipmentCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children EquipmentCategory[] @relation("EquipmentCategoryTree")
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([parentId])
  @@index([name])
}

// En enhet er en maskin/utstyr som står hos kunden, f.eks. en port, en pumpe
// eller et aggregat. Kunden kan ha mange enheter. Enheten kan i tillegg inngå
// i et hierarki (bygg → system → enhet) og ha målinger, garanti og QR-identitet.
model Product {
  id           String  @id @default(cuid())
  model        String
  serialNumber String?
  location     String?

  customerId    String
  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  workOrder     WorkOrder[]
  reportUnits   ReportUnit[]
  contractLines ContractLine[]

  /// Fysisk sted der utstyret står. Tomt betyr kundens primære adresse.
  siteId String?
  site   CustomerSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  // Kategoritre og fysisk/teknisk hierarki. To ulike trær med hvert sitt formål:
  // kategorien sier hva utstyret er, hierarkiet hvor det hører til.
  categoryId String?
  category   EquipmentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  parentId String?
  parent   Product?  @relation("EquipmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Product[] @relation("EquipmentHierarchy")

  status      EquipmentStatus @default(ACTIVE)
  criticality Int             @default(2) // 1 = kritisk, 2 = normal, 3 = lav
  meterUnit   String? // timer | km | sykluser

  installDate        DateTime? @db.Date
  warrantyUntil      DateTime? @db.Date
  /// Satt når garantiutløp er varslet, slik at varselet bare sendes én gang.
  warrantyNotifiedAt DateTime?

  /// Tilfeldig token i QR-etiketten. Roteres når etiketten skal sperres.
  qrToken String? @unique

  meterReadings    MeterReading[]
  maintenancePlans MaintenancePlan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([customerId])
  @@index([customerId, serialNumber])
  @@index([siteId])
  @@index([categoryId])
  @@index([parentId])
  @@index([status])
  @@index([warrantyUntil])
  @@index([model(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_model_trgm")
  @@index([serialNumber(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_serialNumber_trgm")
  @@index([location(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_location_trgm")
}

/// Livssyklusen til en serviceavtale. `isActive` beholdes som et avledet
/// felt for eldre kode og er alltid `status = ACTIVE`.
enum ContractStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
  TERMINATED
}

enum RenewalMode {
  AUTO
  MANUAL
}

/// En måling fra utstyret. `source` er MANUAL | VISIT | IMPORT. Verdien er
/// desimal fordi både timer, kilometer og sykluser kan ha desimaler.
model MeterReading {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  value     Decimal  @db.Decimal(12, 2)
  readAt    DateTime
  source    String   @default("MANUAL")
  visitId   String?
  visit     Visit?   @relation(fields: [visitId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  note      String?
  createdAt DateTime @default(now())

  @@index([productId, readAt])
  @@index([visitId])
  @@index([userId])
}

enum MaintenanceTrigger {
  CALENDAR
  METER
}

/// En vedlikeholdsplan genererer forebyggende oppdrag enten på kalender
/// (`intervalMonths`) eller når en måler passerer en terskel (`meterInterval`).
model MaintenancePlan {
  id             String             @id @default(cuid())
  title          String
  trigger        MaintenanceTrigger
  /// CALENDAR: antall måneder mellom hver forekomst.
  intervalMonths Int?
  /// METER: antall enheter mellom hvert genererte oppdrag.
  meterInterval  Decimal?           @db.Decimal(12, 2)
  /// Hvor mange dager før forfall oppdraget kan genereres.
  leadDays       Int                @default(14)
  nextDueDate    DateTime?          @db.Date
  /// Siste målerverdi som er brukt som terskelgrunnlag. Null betyr at neste
  /// måling setter utgangspunktet uten å lage et oppdrag.
  lastMeterValue Decimal?           @db.Decimal(12, 2)
  isActive       Boolean            @default(true)

  productId    String?
  product      Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  customerId   String
  customer     Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  templateId   String?
  template     Template?  @relation(fields: [templateId], references: [id], onDelete: SetNull)

  occurrences MaintenancePlanOccurrence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([nextDueDate, isActive])
  @@index([customerId])
  @@index([productId])
  @@index([departmentId])
}

/// Én forekomst av en plan. `@@unique([planId, dueDate])` er den siste skansen
/// mot dobbeltgenerering; tjenestelaget tar i tillegg en advisory lock.
model MaintenancePlanOccurrence {
  id          String          @id @default(cuid())
  planId      String
  plan        MaintenancePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  dueDate     DateTime        @db.Date
  /// PENDING | GENERATED | SKIPPED
  status      String          @default("PENDING")
  workOrderId String?         @unique
  workOrder   WorkOrder?      @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  /// Målerverdien som utløste en METER-forekomst.
  meterValue  Decimal?        @db.Decimal(12, 2)
  createdAt   DateTime        @default(now())

  @@unique([planId, dueDate])
  @@index([status, dueDate])
}

// En serviceavtale beskriver en gjentagende service for en kunde. Hver gang
// neste service faller forfaller, opprettes et nytt oppdrag med kundedataene
// ferdig utfylt. Sjekklisten er en mal som festes til oppdraget, men selve
// rapporten er alltid ny og tom – den forrige rapporten legges ved som PDF.
model Contract {
  id                String         @id @default(cuid())
  title             String
  /// Menneskelig, valgfri avtalenummer. Unik når den er satt.
  contractNumber    String?        @unique
  /// Intervall i måneder. Bare 3, 6, 12 og 24 er gyldige.
  intervalMonths    Int
  startDate         DateTime       @db.Date
  /// Siste gyldige dag. Tom betyr tidsubegrenset.
  endDate           DateTime?      @db.Date
  /// Neste dato det skal opprettes et oppdrag for.
  nextServiceDate   DateTime       @db.Date
  status            ContractStatus @default(ACTIVE)
  /// Avledet av `status`; beholdes for eksisterende spørringer og backfill.
  isActive          Boolean        @default(true)
  renewalMode       RenewalMode    @default(MANUAL)
  /// Antall dager før utløp en manuell fornyelse bør varsles om.
  noticeDays        Int            @default(30)
  /// Referanseverdi for prisjustering. Ingen fakturering eller beregning.
  indexationPercent Decimal?       @db.Decimal(5, 2)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  // Avtalen eier avdelingen som de genererte oppdragene havner i.
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  // Kontaktpersonen som skal stå på de genererte oppdragene. Tom betyr at
  // kundens første kontaktperson brukes.
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  // Sjekklistemalen som festes til hvert genererte oppdrag.
  templateId String?
  template   Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  // SLA-avtalen og prislisten er referanser. Prislisten brukes bare til
  // visning; systemet har ingen faktureringssemantikk.
  slaPolicyId String?
  slaPolicy   SlaPolicy? @relation(fields: [slaPolicyId], references: [id], onDelete: SetNull)
  priceListId String?
  priceList   PriceList? @relation(fields: [priceListId], references: [id], onDelete: SetNull)

  lines      ContractLine[]
  workOrders WorkOrder[]

  @@index([customerId])
  @@index([departmentId])
  @@index([nextServiceDate])
  @@index([isActive, nextServiceDate])
  @@index([status, endDate])
  @@index([slaPolicyId])
  @@index([priceListId])
}

/// Dekningen en avtale gir. `productId = null` betyr alt utstyr hos kunden.
model ContractLine {
  id                String   @id @default(cuid())
  contractId        String
  contract          Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  scope             String   @default("")
  visitsPerYear     Int?
  responseMinutes   Int?
  resolutionMinutes Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  @@index([contractId])
  @@index([productId])
}

/// Prisliste er referansedata for visning. Ingen beløp brukes i fakturering.
model PriceList {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  items     PriceListItem[]
  contracts Contract[]

  @@index([isActive])
}

model PriceListItem {
  id          String    @id @default(cuid())
  priceListId String
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  code        String
  label       String
  unit        String
  /// Visningsbeløp. Systemet beregner eller fakturerer aldri dette.
  amount      Decimal   @db.Decimal(12, 2)

  @@unique([priceListId, code])
  @@index([priceListId])
}

/// Svar- og løsningsfrist for oppdrag. En avdeling kan ha flere policyer;
/// avtalen peker på den som gjelder.
model SlaPolicy {
  id                String      @id @default(cuid())
  name              String
  departmentId      String?
  department        Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  responseMinutes   Int
  resolutionMinutes Int
  businessHoursOnly Boolean     @default(true)
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @default(now()) @updatedAt

  contracts Contract[]
  clocks    SlaClock[]

  @@index([departmentId])
  @@index([isActive])
}

enum SlaState {
  ON_TRACK
  AT_RISK
  BREACHED
  MET
  CANCELLED
}

/// Én klokke per oppdrag og policy. Tidspunktene er absolutte og regnet ut
/// gjennom `src/server/business-hours.ts`, også over sommertid.
model SlaClock {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  policyId    String
  policy      SlaPolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)
  startedAt   DateTime
  respondBy   DateTime
  resolveBy   DateTime
  respondedAt DateTime?
  resolvedAt  DateTime?
  state       SlaState  @default(ON_TRACK)
  breachedAt  DateTime?

  @@unique([workOrderId, policyId])
  @@index([state, resolveBy])
  @@index([workOrderId])
  @@index([policyId])
}

/// Åpningstider per ukedag, minutter fra midnatt i Europe/Oslo. 0 = mandag.
model BusinessHours {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  weekday      Int
  openMinute   Int
  closeMinute  Int

  @@unique([departmentId, weekday])
  @@index([departmentId])
}

/// Helligdag som lukker SLA-klokken. Uten avdeling gjelder den alle.
model Holiday {
  id           String      @id @default(cuid())
  date         DateTime    @db.Date
  name         String
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([date, departmentId])
  @@index([date])
  @@index([departmentId])
}

model CustomerAttachment {
  id        String   @id @default(cuid())
  fileName  String
  dataUrl   String
  createdAt DateTime @default(now())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

/// Overordnet kategori for en mal. HMS-maler vises i HMS-flaten og på
/// oppdragets HMS-dokumentasjon, service-maler i den vanlige sjekklisten.
enum TemplateCategory {
  SERVICE
  HMS
}

/// Undertype for HMS-skjemaer. Styrer gruppering i HMS-biblioteket.
enum HmsFormType {
  GENERAL
  SJA
  HOT_WORK
  INTERNAL_CONTROL
  DEVIATION
  SAFETY_ROUND
  WRITTEN_INSTRUCTION
}

enum WorkStatus {
  PLANNED
  IN_PROGRESS
  WAITING
  COMPLETED
  PENDING
  CANCELLED
  OPEN
}

/// Kundens bestilling fra kundeportalen. Én bestilling hører til nøyaktig ett
/// oppdrag, og beholder ønsket tid, utstyr og kontaktperson som et snapshot.
enum BookingRequestStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum BookingEventType {
  CREATED
  CONFIRMED
  RESCHEDULED
  CANCELLED
  EXPIRED
}

/// Status for en planlagt visitt. Flyten er PLANNED → ASSIGNED → EN_ROUTE →
/// ON_SITE → DONE, med CANCELLED som alternativ før visitten er fullført.
/// DONE og CANCELLED er lukkede tilstander.
enum VisitStatus {
  PLANNED
  ASSIGNED
  EN_ROUTE
  ON_SITE
  DONE
  CANCELLED
}

model WorkOrder {
  id                    String     @id @default(cuid())
  title                 String
  /// Eksternt ordrenummer fra kundens system.
  orderNumber           String?
  /// Normalisert ordrenummer for duplikatkontroll/søk.
  orderNumberNormalized String?
  /// Unik nøkkel for automatisk opprettet utbedringsoppdrag.
  deviationSourceKey    String?    @unique
  description           String?
  /// Arbeidssted for dette oppdraget. Tomt betyr kundens adresse.
  address               String?
  postalCode            String?
  city                  String?
  /// Geokodede koordinater for arbeidsstedet, med hash av adressegrunnlaget.
  latitude              Float?
  longitude             Float?
  geoAddressHash        String?
  scheduledFor          DateTime?  @db.Date
  /// Siste dag oppdraget varer (inklusiv). Tom betyr éndagsoppdrag.
  scheduledTo           DateTime?  @db.Date
  status                WorkStatus @default(PLANNED)
  creatorName           String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @default(now()) @updatedAt
  /// Myk sletting: oppdraget skjules fra lister, men kan gjenopprettes.
  deletedAt             DateTime?
  deletedBy             String?
  /// Bevaringsplikt: hindrer automatisk hard sletting etter fristen.
  legalHold             Boolean    @default(false)

  technicians User[] @relation("WorkOrderTechnicians")

  // Oppdraget tilhører én avdeling, og er bare synlig for ansatte der.
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  /// Fysisk sted for oppdraget. Tomt betyr kundens primære adresse.
  siteId String?
  site   CustomerSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  attachments Attachment[]

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  // Satt når oppdraget er generert fra en serviceavtale.
  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  templates      Template[]      @relation("WorkOrderTemplates")
  reports        Report[]
  workComments   Comment[]       @relation("WorkOrderComments")
  tags           Tag[]           @relation("WorkOrderTags")
  reportDrafts   ReportDraft[]
  bookingRequest BookingRequest?

  // Planlagte visiter og påkrevd kompetanse. `scheduledFor`/`scheduledTo`
  // speiler fortsatt min/maks av visitene for eksisterende konsumenter.
  visits            Visit[]
  skillRequirements WorkOrderSkill[]
  slaClocks         SlaClock[]
  trackingLinks     TrackingLink[]
  reviews           Review[]
  messageThreads    MessageThread[]
  smsMessages       SmsMessage[]

  /// Forekomst av en vedlikeholdsplan som genererte dette oppdraget.
  maintenanceOccurrence MaintenancePlanOccurrence?

  @@unique([departmentId, orderNumberNormalized])
  // Hindrer at to samtidige kjøringer lager samme serviceavtale-oppdrag.
  @@unique([contractId, scheduledFor])
  @@index([departmentId])
  @@index([customerId])
  @@index([siteId])
  @@index([status])
  @@index([scheduledFor])
  @@index([contractId])
  @@index([orderNumber])
  @@index([orderNumberNormalized])
  @@index([scheduledTo])
  @@index([deletedAt])
  @@index([departmentId, status, scheduledFor])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "WorkOrder_title_trgm")
}

/// En planlagt, tildelbar tidsblokk i et oppdrag. Et oppdrag kan ha flere
/// visiter; `WorkOrder.scheduledFor`/`scheduledTo` er avledet fra disse.
/// Tidsstemplene er absolutte tidspunkt (timestamptz), slik at sommertid
/// håndteres riktig uten å endre veggklokketiden i databasen.
model Visit {
  id          String      @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder   @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  sequence    Int         @default(0)
  startsAt    DateTime    @db.Timestamptz(3)
  endsAt      DateTime    @db.Timestamptz(3)
  allDay      Boolean     @default(false)
  status      VisitStatus @default(PLANNED)
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt

  /// Eksplisitte statustidspunkt. De settes atomisk sammen med statusen i
  /// `setVisitStatus`, slik at rapportering og ETA ikke må utlede tid fra
  /// `updatedAt` (som også endres av notater og flytting).
  enRouteAt DateTime? @db.Timestamptz(3)
  onSiteAt  DateTime? @db.Timestamptz(3)
  doneAt    DateTime? @db.Timestamptz(3)

  technicians   VisitTechnician[]
  meterReadings MeterReading[]

  bookingRequest BookingRequest? @relation("BookingVisit")

  trackingLinks TrackingLink[]
  locationPings VisitLocationPing[]
  reviews       Review[]

  @@index([workOrderId, startsAt])
  @@index([startsAt, endsAt])
  @@index([status])
}

model VisitTechnician {
  visitId String
  userId  String
  visit   Visit  @relation(fields: [visitId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([visitId, userId])
  @@index([userId])
}

/// Offentlig sporingslenke for én visitt. Bare SHA-256-hashen av det
/// 32-byte tilfeldige tokenet lagres; klarteksten vises én gang ved oppretting.
/// Lenken er gyldig til `expiresAt` (visittens slutt + 2 timer) og kan
/// tilbakekalles umiddelbart.
model TrackingLink {
  id        String @id @default(cuid())
  tokenHash String @unique

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  visitId String
  visit   Visit  @relation(fields: [visitId], references: [id], onDelete: Cascade)

  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime? @db.Timestamptz(3)

  @@index([visitId, revokedAt])
  @@index([workOrderId])
  @@index([expiresAt])
}

/// Posisjonsping fra montørens enhet mens visitten er EN_ROUTE. Radene er
/// korte leveår: en sveipende jobb sletter alt eldre enn 24 timer, og ingen
/// historikk eksponeres offentlig. Koordinatene brukes bare til å beregne ETA.
model VisitLocationPing {
  id         String   @id @default(cuid())
  visitId    String
  visit      Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  latitude   Float
  longitude  Float
  recordedAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([visitId, recordedAt])
  @@index([recordedAt])
  @@index([userId])
}

/// Kundeomtale etter fullført visitt. Én rad per visitt (`visitId` unik), slik
/// at gjentatte forespørsler er idempotente. Tokenet lagres bare som hash, og
/// innsending er atomisk begrenset til én gang (`submittedAt`).
model Review {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  visitId     String?   @unique
  visit       Visit?    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  score       Int?
  comment     String?
  requestedAt DateTime? @db.Timestamptz(3)
  submittedAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now())

  @@index([workOrderId, submittedAt])
  @@index([submittedAt, score])
}

/// Kompetanse som kan kreves av et oppdrag og tildeles en montør.
model Skill {
  id       String  @id @default(cuid())
  key      String  @unique
  label    String
  category String?

  users      UserSkill[]
  workOrders WorkOrderSkill[]
}

model UserSkill {
  userId     String
  skillId    String
  level      Int?
  validUntil DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
  @@index([skillId])
}

model WorkOrderSkill {
  workOrderId String
  skillId     String
  mandatory   Boolean @default(true)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  skill     Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([workOrderId, skillId])
  @@index([skillId])
}

/// Gjentakende ukentlig arbeidstid. Minutter fra midnatt, lokal tid
/// (Europe/Oslo), med 0 = mandag … 6 = søndag.
model UserAvailability {
  id          String @id @default(cuid())
  userId      String
  weekday     Int
  startMinute Int
  endMinute   Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, weekday])
}

/// Fravær som blokkerer tildeling i en periode. `kind` er FERIE | SYKDOM |
/// KURS | ANNET.
model Absence {
  id       String   @id @default(cuid())
  userId   String
  startsAt DateTime @db.Timestamptz(3)
  endsAt   DateTime @db.Timestamptz(3)
  kind     String
  note     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startsAt, endsAt])
}

/// Geografisk ansvarsområde for en avdeling. Postnummerprefikser og
/// kommunekoder brukes til å foreslå riktig montør; radius er et supplement
/// når adressen bare har koordinater.
model Territory {
  id           String @id @default(cuid())
  name         String
  departmentId String

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  /// Postnummerprefikser, f.eks. «01», «02». Tom liste betyr ingen begrensning.
  postalPrefixes    String[] @default([])
  /// Kommunekoder (SSB), f.eks. «0301». Tom liste betyr ingen begrensning.
  municipalityCodes String[] @default([])
  radiusKm          Int?
  centerLat         Float?
  centerLng         Float?
  isActive          Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([departmentId, name])
  @@index([departmentId, isActive])
}

/// Planlagt kapasitet for en avdeling på en dato. Uten `technicianId` gjelder
/// raden hele avdelingen; med en montør overstyrer den avdelingskapasiteten.
/// En delvis unik indeks i migreringen hindrer to avdelingsrader for samme dag,
/// fordi PostgreSQL ellers tillater flere NULL-verdier i en vanlig unik nøkkel.
model CapacityPlan {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  date         DateTime @db.Date
  technicianId String?
  technician   User?    @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  /// Tilgjengelige minutter denne dagen. 0 er en bevisst stengt dag.
  capacityMinutes Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([departmentId, date, technicianId])
  @@index([departmentId, date])
  @@index([technicianId, date])
}

/// Rekkefølgen og vektene dispatch-motoren bruker når den rangerer montører.
/// `mode` er SKILLS | DISTANCE | EARLIEST | CUSTOM; `weights` er et JSON-objekt
/// med tall for skills, distance, travel, free, sla og load.
model AssignmentPolicy {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  mode     String  @default("SKILLS")
  weights  Json    @default("{}")
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId, isActive])
}

/// Kundens bestillingsforespørsel. Oppdraget er den operative saken; denne
/// raden bevarer det kunden faktisk ba om, slik at ønsket tid og historikk
/// ikke endres når kontoret planlegger.
model BookingRequest {
  id          String    @id @default(cuid())
  /// Kort, menneskelig referanse kunden kan oppgi til kontoret.
  reference   String    @unique
  workOrderId String    @unique
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// Ønsket startdato (kalenderdato) og tidsvindu, lagret som HH:mm.
  requestedDate DateTime @db.Date
  requestedFrom String
  requestedTo   String

  /// Tjenestetypen kunden valgte i den nye slotvelgeren. Eldre bestillinger
  /// (og kontorets manuelle forespørsler) kan mangle denne.
  serviceType String?

  /// Stedet bestillingen gjelder. Adressen kopieres også til oppdraget, slik
  /// at senere endringer i kundens stedsregister ikke flytter historikken.
  siteId String?
  site   CustomerSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  /// Visitten som ble opprettet da bestillingen ble bekreftet. Én bestilling
  /// peker på nøyaktig én visitt; eldre forespørsler kan mangle den.
  visitId String? @unique
  visit   Visit?  @relation("BookingVisit", fields: [visitId], references: [id], onDelete: SetNull)

  /// Utstyr og tekniker er snapshots fra bestillingstidspunktet. Id-ene er
  /// validert mot kundens egne enheter og avdelingens aktive ansatte.
  equipmentId             String?
  equipmentLabel          String?
  preferredTechnicianId   String?
  preferredTechnicianName String?

  contactName  String
  contactPhone String

  status      BookingRequestStatus @default(PENDING)
  cancelledAt DateTime?
  confirmedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  events BookingRequestEvent[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([siteId])
}

/// Synlig endringshistorikk for en bestilling. Hver rad er et uforanderlig
/// hendelsesøyeblikk; selve bestillingen viser alltid gjeldende ønsket tid.
model BookingRequestEvent {
  id               String         @id @default(cuid())
  bookingRequestId String
  bookingRequest   BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)

  type    BookingEventType
  /// Kort forklaring til kunden, f.eks. «Ny tid forespurt».
  message String?

  requestedDate DateTime? @db.Date
  requestedFrom String?
  requestedTo   String?

  actorName String?
  createdAt DateTime @default(now())

  @@index([bookingRequestId, createdAt])
}

/// Kortvarig reservasjon av en ledig time mens kunden fyller ut skjemaet.
/// Raden blokkerer timen i tilgjengelighetsberegningen til den utløper eller
/// konsumeres av en bekreftet bestilling. Utløpte rader ryddes av jobbworkeren.
model BookingHold {
  id    String @id @default(cuid())
  /// Uforutsigbart engangstoken som klienten sender tilbake ved bekreftelse.
  token String @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  siteId String?
  site   CustomerSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  technicianId String?
  technician   User?   @relation("BookingHoldTechnician", fields: [technicianId], references: [id], onDelete: SetNull)

  startsAt DateTime @db.Timestamptz(3)
  endsAt   DateTime @db.Timestamptz(3)

  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now())

  @@index([expiresAt])
  @@index([customerId, expiresAt])
  @@index([technicianId, startsAt, endsAt])
  @@index([siteId])
}

model Tag {
  id         String      @id @default(cuid())
  name       String      @unique
  color      String      @default("#3b82f6")
  workOrders WorkOrder[] @relation("WorkOrderTags")
}

model DocumentTag {
  id        String     @id @default(cuid())
  name      String     @unique
  color     String     @default("#3b82f6")
  documents Document[] @relation("DocumentTagRelation")
}

model DocumentFolder {
  id        String           @id @default(cuid())
  name      String
  parentId  String?
  parent    DocumentFolder?  @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  DocumentFolder[] @relation("FolderChildren")
  documents Document[]

  @@index([parentId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "DocumentFolder_name_trgm")
}

model Document {
  id          String  @id @default(cuid())
  title       String
  description String?
  fileName    String
  filePath    String
  fileSize    Int     @default(0)
  mimeType    String  @default("application/pdf")

  // Ekstrahert tekst fra PDF for fulltekst-søk. pageTexts er JSON-array
  // [{page: number, text: string}] for side-spesifikk navigasjon.
  contentText String?
  pageTexts   String?

  // PostgreSQL-generert tsvector for fulltekst-søk. Prisma kan ikke uttrykke
  // GENERATED-kolonnen, så den opprettes i migreringen.
  searchTsv Unsupported("tsvector")?

  folderId String?
  folder   DocumentFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  tags DocumentTag[] @relation("DocumentTagRelation")

  uploadedBy String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  deletedBy  String?

  versions DocumentVersion[]

  @@index([folderId])
  @@index([title])
  @@index([deletedAt])
  @@index([searchTsv], type: Gin, map: "Document_searchTsv")
}

// Tidligere filversjoner av et dokument. Når filen byttes ut, beholdes den
// gamle filen her slik at den kan lastes ned igjen senere.
model DocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  fileName String
  filePath String
  fileSize Int    @default(0)
  mimeType String @default("application/pdf")

  createdBy String?
  createdAt DateTime @default(now())

  @@index([documentId])
}

model Report {
  id          String   @id @default(cuid())
  dataJson    String
  comments    String?
  completedAt DateTime @default(now())

  // Signaturer. Tekniker og kunde signerer hver for seg, og begge er valgfrie
  // (en jobb kan signeres av bare én av partene).
  technicianSignatureUrl String?
  technicianName         String?
  customerSignatureUrl   String?
  customerName           String?

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  templateId String?
  template   Template? @relation(fields: [templateId], references: [id])

  // Øyeblikksbilde av malen da rapporten ble signert, slik at senere endringer
  // i malen ikke endrer en allerede signert rapport.
  templateTitle        String?
  /// Rapportens visningsnavn, kopiert fra malen da rapporten ble laget.
  name                 String?
  /// Automatisk rapportnummer for HMS-rapporter, f.eks. abc1234.
  reportNumber         String?          @unique
  /// Om rapporten har enheter. Snapshot fra malen.
  requiresUnits        Boolean          @default(true)
  /// Kategori og HMS-type frosset ved signering.
  templateCategory     TemplateCategory @default(SERVICE)
  hmsType              HmsFormType?
  templateSnapshotJson String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Rapporten låses automatisk når den er fylt ut, og kan ikke endres igjen før
  // en administrator låser den opp. Det hindrer at en signert rapport endres i
  // ettertid – noe som er viktig for sporbarheten.
  isLocked     Boolean   @default(false)
  lockedAt     DateTime?
  lockedByName String?

  // Cache for generert PDF. pdfHash beskriver innholdet PDF-en ble laget fra,
  // slik at den kan brukes på nytt til rapporten endres.
  pdfUrl         String?
  pdfHash        String?
  pdfGeneratedAt DateTime?

  // Kundeportalens kvittering på at rapporten er mottatt.
  customerAcknowledgedAt      DateTime?
  customerAcknowledgedBy      String?
  customerAcknowledgedComment String?

  /// Revisjonsnummer. Økes for hver endring som lagres som revisjon.
  revision Int @default(0)

  deletedAt DateTime?
  deletedBy String?
  /// Bevaringsplikt: hindrer automatisk hard sletting etter fristen.
  legalHold Boolean   @default(false)

  units     ReportUnit[]
  revisions ReportRevision[]

  @@unique([workOrderId, templateId])
  @@index([workOrderId])
  @@index([completedAt])
  @@index([workOrderId, createdAt])
  @@index([deletedAt])
  @@index([reportNumber(ops: raw("gin_trgm_ops"))], type: Gin, map: "Report_reportNumber_trgm")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Report_name_trgm")
  @@index([templateTitle(ops: raw("gin_trgm_ops"))], type: Gin, map: "Report_templateTitle_trgm")
}

/// Uforanderlig øyeblikksbilde av en rapport før en endring. Signerte rapporter
/// skal alltid kunne rekonstrueres, selv om de låses opp og endres senere.
model ReportRevision {
  id                          String           @id @default(cuid())
  reportId                    String
  report                      Report           @relation(fields: [reportId], references: [id], onDelete: Cascade)
  revision                    Int
  dataJson                    String
  unitsJson                   String
  comments                    String?
  templateTitle               String?
  name                        String?
  /// Rapportnummeret rapporten hadde da revisjonen ble laget.
  reportNumber                String?
  requiresUnits               Boolean          @default(true)
  templateCategory            TemplateCategory @default(SERVICE)
  hmsType                     HmsFormType?
  completedAt                 DateTime?
  templateSnapshotJson        String?
  technicianSignatureUrl      String?
  customerSignatureUrl        String?
  technicianName              String?
  customerName                String?
  customerAcknowledgedAt      DateTime?
  customerAcknowledgedBy      String?
  customerAcknowledgedComment String?
  reason                      String?
  createdById                 String?
  createdAt                   DateTime         @default(now())

  @@unique([reportId, revision])
  @@index([reportId, createdAt])
}

// Én enhet som inngår i en rapport. Feltene er øyeblikksbilder av enheten slik
// den var da rapporten ble skrevet, slik at rapporten forblir lesbar selv om
// enheten endres eller slettes på kundekortet senere.
model ReportUnit {
  id           String  @id @default(cuid())
  label        String
  serialNumber String?
  location     String?

  // GODKJENT | AVVIK – samme verdier som hovedresultatet.
  status      String  @default("GODKJENT")
  answersJson String  @default("{}")
  comment     String?

  reportId String
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([reportId])
  @@index([productId])
}

// Midlertidig lagring (kladd) av en sjekkliste. Én kladd per bruker, oppdrag og
// mal, slik at flere teknikere kan fylle ut samme sjekkliste uten å overskrive
// hverandre. Kladden slettes når rapporten lagres.
model ReportDraft {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  templateId  String
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  dataJson      String
  updatedByName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workOrderId, templateId, userId])
  @@index([workOrderId])
  @@index([userId])
}

model Template {
  id               String            @id @default(cuid())
  title            String
  /// Navnet som vises på produserte rapporter/PDF. Tomt = bruk title.
  reportName       String?
  /// Kort beskrivelse til malbiblioteket.
  description      String?
  /// SERVICE = vanlig sjekkliste, HMS = HMS-dokumentasjon.
  category         TemplateCategory  @default(SERVICE)
  /// Undertype når category = HMS.
  hmsType          HmsFormType?
  /// Om rapporten skal knyttes til enheter. Kan slås av per mal.
  requiresUnits    Boolean           @default(true)
  fieldsJson       String
  reports          Report[]
  workOrder        WorkOrder[]       @relation("WorkOrderTemplates")
  contracts        Contract[]
  maintenancePlans MaintenancePlan[]

  @@index([category, hmsType])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Template_title_trgm")
}

model Attachment {
  id       String @id @default(cuid())
  fileName String
  dataUrl  String

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
}

// Metadata for opplastede filer, slik at /uploads kan kreve tilgang per fil.
// Selve filen ligger på disk med et tilfeldig navn (storedName).
model Upload {
  id           String @id @default(cuid())
  storedName   String @unique
  originalName String
  mimeType     String
  size         Int    @default(0)

  // WORK_ORDER | CUSTOMER | DOCUMENT | USER
  ownerType    String
  ownerId      String?
  departmentId String?
  customerId   String?
  uploadedById String?

  /// SHA-256 av filinnholdet, brukt til deduplisering av kladdesignaturer.
  contentHash String?

  createdAt DateTime @default(now())

  @@index([ownerType, ownerId])
  @@index([departmentId])
  @@index([uploadedById])
  @@index([contentHash])
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

// Vedvarende jobbkø for PDF-tekst og OCR. Erstatter den in-memory køen, slik
// at jobber overlever restart og kan kjøres av flere instanser.
model DocumentJob {
  id         String    @id @default(cuid())
  documentId String?
  /// PDF_TEXT | PDF_OCR
  type       String
  status     JobStatus @default(PENDING)
  attempts   Int       @default(0)
  runAt      DateTime  @default(now())
  lockedAt   DateTime?
  lastError  String?
  createdAt  DateTime  @default(now())

  @@index([status, runAt])
}

// Delt teller for rate limiting. Erstatter in-memory-telleren der flere
// instanser må se samme grense (innlogging, passordnullstilling, PDF, søk).
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  userName   String
  actorId    String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType])
  @@index([entityId])
  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
}

model Notification {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// ASSIGNMENT | DATE_CHANGED | CANCELLED | REPORT_READY | BOOKING | CONTRACT_DUE | OVERDUE | MESSAGE
  type               String
  title              String
  /// Når varselet er laget med en oversettbar nøkkel, er dette nøkkelen og
  /// `title` er tom. Eldre varsler har vanlig tekst i `title`.
  titleKey           String?
  body               String?
  bodyKey            String?
  /// Verdier til {placeholder}-plassholdere i titleKey/bodyKey.
  params             Json?
  /// Menneskevennlig kilde, f.eks. «Oppdrag: testoppdrag · Biniam» eller
  /// «Kunde: Pipelife Norge AS». Frosset ved opprettelse slik at varselet
  /// fortsatt viser hvor det kom fra selv om oppdraget senere endres.
  sourceLabel        String?
  href               String?
  readAt             DateTime?
  /// Unik nøkkel per hendelse, slik at samme varsel ikke lages to ganger.
  dedupeKey          String?   @unique
  /// E-postkvittering: null betyr at varselet fortsatt venter på utsending.
  emailSentAt        DateTime?
  emailError         String?
  emailAttempts      Int       @default(0)
  emailNextAttemptAt DateTime  @default(now())
  /// Kort lease mens en instans sender e-posten, slik at flere instanser
  /// ikke sender samme varsel samtidig.
  emailLockedAt      DateTime?
  emailLockedBy      String?
  createdAt          DateTime  @default(now())

  @@index([userId, readAt, createdAt])
  @@index([createdAt])
  @@index([emailSentAt, emailNextAttemptAt])
}

model NotificationPreference {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   String
  inApp  Boolean @default(true)
  email  Boolean @default(true)

  @@unique([userId, type])
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  query     String
  /// Søkefiltre som JSON, slik at et lagret søk kan gjenopprettes eksakt.
  filters   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId, updatedAt])
}

/// Anonymisert nok for intern analyse, men beholder søketeksten slik at
/// nulltreff og populære søk kan forbedres. Søketeksten maskeres før lagring,
/// og raden har ingen kobling til brukeren som søkte.
model SearchLog {
  id              String   @id @default(cuid())
  query           String
  normalizedQuery String
  resultCount     Int
  latencyMs       Int
  filters         Json?
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([resultCount, createdAt])
  @@index([normalizedQuery, createdAt])
}

model Branding {
  id           String   @id @default(cuid())
  companyName  String   @default("Min Bedrift")
  logoUrl      String?
  primaryColor String   @default("#2563eb")
  updatedAt    DateTime @updatedAt
}

model Comment {
  id          String     @id @default(cuid())
  content     String
  authorName  String?
  workOrderId String?
  workOrder   WorkOrder? @relation("WorkOrderComments", fields: [workOrderId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     Contact?   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())

  @@index([workOrderId])
  @@index([customerId])
  @@index([contactId])
}

/// Globale kartinnstillinger. Én rad med id "default".
model MapSettings {
  id              String   @id @default("default")
  /// osm | maptiler | mapbox
  provider        String   @default("osm")
  /// API-nøkkel/token for leverandøren. Vises aldri i klientinnstillinger.
  apiKey          String?
  /// osm | topo | light | satellite
  defaultLayer    String   @default("osm")
  defaultZoom     Int      @default(6)
  centerLat       Float?
  centerLng       Float?
  scrollWheelZoom Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

/// Utgående og innkommende SMS.
///
/// Utgående rader er den vedvarende køen: `QUEUED` → `SENDING` → `SENT`/
/// `DELIVERED`, eller `DEAD_LETTER` etter tre mislykkede forsøk. Innkommende
/// webhook-leveranser lagres også her, med `direction = INBOUND`, slik at
/// `@@unique([provider, providerId])` gjør gjentatt levering idempotent.
model SmsMessage {
  id             String    @id @default(cuid())
  direction      String    @default("OUTBOUND")
  /// console | linkmobility | pswincom | twilio
  provider       String    @default("console")
  providerId     String?
  to             String
  from           String?
  body           String
  templateKey    String?
  locale         String?
  /// QUEUED | SENDING | SENT | DELIVERED | FAILED | DEAD_LETTER | RECEIVED
  status         String    @default("QUEUED")
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  lastError      String?
  workOrderId    String?
  contactId      String?
  userId         String?
  departmentId   String?
  threadId       String?
  createdAt      DateTime  @default(now())
  sentAt         DateTime?
  deliveredAt    DateTime?
  deadLetteredAt DateTime?

  workOrder  WorkOrder?     @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  contact    Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  user       User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  department Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  thread     MessageThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)

  @@unique([provider, providerId])
  @@index([status, nextAttemptAt])
  @@index([status, createdAt])
  @@index([contactId, createdAt])
  @@index([workOrderId, createdAt])
  @@index([threadId, createdAt])
}

/// Én samtale mellom kunden og kontoret. `threadKey` er en stabil, beregnet
/// nøkkel (kunde + kontakt + eventuelt oppdrag), slik at to samtidige
/// innkommende meldinger ikke lager hver sin tråd.
model MessageThread {
  id            String      @id @default(cuid())
  threadKey     String      @unique
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  workOrderId   String?
  workOrder     WorkOrder?  @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  contactId     String?
  contact       Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  subject       String?
  /// Antall innkommende meldinger kontoret ennå ikke har lest.
  unreadCount   Int         @default(0)
  lastMessageAt DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  messages    Message[]
  smsMessages SmsMessage[]

  @@index([customerId, lastMessageAt])
  @@index([departmentId, lastMessageAt])
  @@index([workOrderId])
  @@index([contactId])
}

/// En melding i en tråd, uavhengig av kanal. Innkommende SMS har også en
/// `SmsMessage`-rad for idempotens; `smsMessageId` peker på den.
model Message {
  id           String        @id @default(cuid())
  threadId     String
  thread       MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  /// INBOUND | OUTBOUND
  direction    String
  /// SMS | PORTAL | EMAIL
  channel      String        @default("SMS")
  body         String
  authorUserId String?
  author       User?         @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  smsMessageId String?
  fromAddress  String?
  toAddress    String?
  readAt       DateTime?
  createdAt    DateTime      @default(now())

  @@index([threadId, createdAt])
  @@index([smsMessageId])
  @@index([authorUserId])
}

/// Samtykke og reservasjon per kanal. En rad med `optedIn = true` og
/// `optedOut = false` er den eneste tilstanden som tillater utsending.
/// Manglende rad betyr «ukjent» og blokkerer SMS.
model ChannelPreference {
  id          String    @id @default(cuid())
  contactId   String?
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId  String?
  /// SMS | EMAIL | PORTAL
  channel     String    @default("SMS")
  optedIn     Boolean   @default(false)
  optedOut    Boolean   @default(false)
  consentedAt DateTime?
  optedOutAt  DateTime?
  source      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([contactId, channel])
  @@unique([userId, channel])
  @@index([customerId, channel])
}

/// Redigerbar SMS-mal per hendelse og språk. `variables` er den eksplisitte
/// listen over {plassholdere} malen kan bruke.
model SmsTemplate {
  id        String   @id @default(cuid())
  eventKey  String
  locale    String   @default("nb")
  body      String
  variables String[] @default([])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventKey, locale])
  @@index([eventKey, isActive])
}

/// Globale SMS-innstillinger. Én rad med id "default". Leverandør og
/// avsendernavn kommer fra miljøet og vises bare lesbart i UI-en.
model SmsSetting {
  id             String   @id @default("default")
  defaultLocale  String   @default("nb")
  optOutKeywords String[] @default(["STOP", "STOPP", "MELD AV", "AVMELD", "UNSUBSCRIBE"])
  optInKeywords  String[] @default(["START", "JA", "MELD PÅ", "PÅMELD", "SUBSCRIBE"])
  /// 0 eller null betyr ingen månedlig grense.
  monthlyCap     Int?     @default(0)
  updatedAt      DateTime @updatedAt
}
