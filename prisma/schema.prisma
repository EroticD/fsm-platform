generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Tilkoblingsadressen settes i prisma.config.mjs (Prisma 7). Klienten får
  // den via driver-adapteren i src/lib/prisma.ts.
}

// Avdelingene avgjør hvilke oppdrag en ansatt kan se. Kunder, dokumenter og
// rapporter er felles for alle avdelinger, mens oppdrag er avdelingssperret.
model Department {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)
  /// Standardavdeling for kundebestillinger og nye oppdrag uten valgt avdeling.
  isDefault   Boolean @default(false)

  /// Live sporing av montør er av som standard. Avdelingen må eksplisitt slå
  /// dette på; se docs/DECISIONS.md (GDPR, D-5).
  trackingEnabled Boolean @default(false)

  // Kontaktinfo for avdelingen/lokasjonen. Vises i kundeportalen.
  phone      String?
  email      String?
  address    String?
  city       String?
  postalCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  workOrders         WorkOrder[]
  contracts          Contract[]
  customers          Customer[]
  slaPolicies        SlaPolicy[]
  businessHours      BusinessHours[]
  holidays           Holiday[]
  maintenancePlans   MaintenancePlan[]
  territories        Territory[]
  capacityPlans      CapacityPlan[]
  assignmentPolicies AssignmentPolicy[]
  messageThreads     MessageThread[]
  smsMessages        SmsMessage[]
  reminderRules      ReminderRule[]
  reminderDispatches ReminderDispatch[]
  quotes             Quote[]
  invoices           Invoice[]

  @@index([isActive])
}

// Roller kan opprettes og redigeres av administrator. Nøkkelen er stabil og
// brukes av koden for spesialroller som ADMIN, TECHNICIAN og CUSTOMER, mens
// visningsnavnet og rettighetene kan endres.
model Role {
  key         String   @id
  label       String   @unique
  description String?
  permissions String[] @default([])
  isSystem    Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@index([isSystem])
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  phone          String?
  emailVerified  DateTime?
  image          String?
  role           String    @default("TECHNICIAN")
  roleDefinition Role      @relation(fields: [role], references: [key], onUpdate: Cascade, onDelete: Restrict)

  password         String?
  resetToken       String?
  resetTokenExpiry DateTime?

  isTwoFactorEnabled      Boolean   @default(false)
  twoFactorSecret         String?
  // Når det pågående 2FA-oppsettet ble startet. Oppsett eldre enn 10 minutter
  // avvises, slik at en gammel hemmelighet ikke kan bekreftes senere.
  twoFactorSetupStartedAt DateTime?

  // Siste TOTP-tidssteg som ble godtatt. Neste verifisering må ligge etter
  // dette, ellers kan samme 30-sekundskode brukes om igjen.
  lastTotpTimeStep Int?

  // Konto må aktiveres manuelt av en administrator før innlogging er tillatt
  isActive Boolean @default(false)

  // Økes når økten skal ugyldiggjøres (passordbytte, rolleendring, 2FA-endring).
  // JWTs med eldre versjon avvises av getCurrentUser().
  sessionVersion Int @default(0)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  /// Ekstern id fra SCIM-provisjonering. Settes bare av SCIM-tjenesten og
  /// brukes til å matche oppdateringer fra identitetsleverandøren.
  scimExternalId String? @unique
  ssoIdentities  SsoIdentity[]
  scimGroups     ScimGroupMember[]

  // Kundeportalbrukere kobles til en kontaktperson på kundekortet
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  /// Språket mottakeren skal få SMS og e-post på. Standard er norsk.
  locale String @default("nb")

  // Ansatte tilhører en avdeling. Kundeportalbrukere kan stå uten.
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  // Tilpassede rettigheter. Når permissionsCustomized er true overstyrer
  // permissions rollens rettigheter helt. Sletting er ikke en rettighet her;
  // det er alltid forbeholdt administrator.
  permissions           String[] @default([])
  permissionsCustomized Boolean  @default(false)

  workOrders WorkOrder[] @relation("WorkOrderTechnicians")

  // Kunder der denne brukeren er ansvarlig montør.
  responsibleCustomers Customer[] @relation("CustomerResponsibleTechnician")

  // Kladder for sjekklister brukeren har begynt å fylle ut.
  reportDrafts ReportDraft[]

  // Kalenderabonnement (iCal). Bare SHA-256-hashen lagres.
  calendarTokenHash       String?   @unique
  calendarTokenCreatedAt  DateTime?
  calendarTokenLastUsedAt DateTime?

  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  pushDevices             PushDevice[]
  pushMessages            PushMessage[]
  savedSearches           SavedSearch[]
  twoFactorRecoveryCodes  TwoFactorRecoveryCode[]
  apiKeys                 ApiKey[]

  // Meldinger skrevet av brukeren, og SMS-samtykke for ansatte.
  messageAuthors     Message[]
  channelPreferences ChannelPreference[]
  smsMessages        SmsMessage[]

  // Planlegging: visittildelinger, kompetanse, arbeidstid og fravær.
  visitAssignments VisitTechnician[]
  skills           UserSkill[]
  availability     UserAvailability[]
  absences         Absence[]
  bookingHolds     BookingHold[]      @relation("BookingHoldTechnician")

  // Målinger registrert av brukeren.
  meterReadings MeterReading[]

  // Eksisterende QR-koder brukeren har registrert på utstyr.
  equipmentQrCodes EquipmentQrCode[] @relation("EquipmentQrCodeCreatedBy")

  // Kapasitetsplaner der brukeren er satt opp med en egen kapasitet.
  capacityPlans CapacityPlan[]

  // Posisjonsping under pågående visitt. Slettes etter 24 timer.
  visitLocationPings VisitLocationPing[]

  @@index([departmentId])
  @@index([role])
  @@index([resetToken])
  @@index([customerId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_name_trgm")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_email_trgm")
}

/// API-nøkkel for integrasjoner. Bare SHA-256-hashen lagres; klarteksttokenet
/// vises én gang ved opprettelse. Prefix er de første tegnene, slik at nøkkelen
/// kan gjenkjennes i grensesnittet uten å avsløre resten.
model ApiKey {
  id      String @id @default(cuid())
  name    String
  keyHash String @unique
  prefix  String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?

  // Tom liste betyr «alle scopes» for nøkler opprettet før scopes ble innført.
  // Nye nøkler får alltid en eksplisitt liste.
  scopes   String[] @default([])
  // Skrivebeskyttet nøkkel: alle andre metoder enn GET/HEAD avvises.
  readOnly Boolean  @default(false)

  @@index([userId])
  @@index([keyHash])
}

/// Kobling mellom en ekstern OIDC-identitet og en lokal bruker.
///
/// `sub` er leverandørens stabile identifikator for klienten, ikke e-post.
/// E-post brukes bare ved første kobling og må være bekreftet av leverandøren.
/// En bruker kan ha identiteter fra flere leverandører, men bare én per
/// leverandør.
model SsoIdentity {
  id       String @id @default(cuid())
  /// Slug fra SSO_PROVIDERS, f.eks. «entra» eller «keycloak».
  provider String
  /// OIDC `sub` fra identitetstokenet.
  subject  String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// E-posten leverandøren oppga ved koblingen. Vises i revisjonsloggen.
  email String?

  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?

  @@unique([provider, subject])
  @@unique([provider, userId])
  @@index([userId])
}

/// Bearer-token for SCIM 2.0-provisjonering. Bare SHA-256-hashen lagres;
/// klarteksttokenet vises én gang ved opprettelse, som for API-nøkler.
model ScimToken {
  id        String @id @default(cuid())
  name      String
  tokenHash String @unique
  prefix    String

  /// Administratoren som opprettet tokenet. Brukes til attribusjon i
  /// revisjonsloggen og for å kunne sperre tokenet når kontoen deaktiveres.
  createdById String?

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?

  @@index([revokedAt])
  @@index([createdById])
}

/// SCIM 2.0-gruppe. Gruppen er leverandørens gruppe, ikke en lokal rolle:
/// medlemskap gir bare tilgang når gruppenavnet finnes i en eksplisitt
/// SCIM_GROUP_ROLE_MAP eller SCIM_GROUP_DEPARTMENT_MAP. Gruppen kan derfor
/// aldri gi ADMIN av seg selv.
model ScimGroup {
  id          String  @id @default(cuid())
  displayName String  @unique
  externalId  String? @unique

  /// SCIM-tokenets oppretter, for attribusjon i revisjonsloggen.
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members ScimGroupMember[]

  @@index([createdAt])
}

/// Medlemskap i en SCIM-gruppe. Slettes sammen med gruppen eller brukeren.
model ScimGroupMember {
  groupId String
  group   ScimGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([groupId, userId])
  @@index([userId])
}

/// Kortlevd nøkkelverdi-lager for SAML. Det gjør AuthnRequest-id-er og
/// replay-vakter delbare mellom appinstanser, i stedet for en prosesslokal
/// cache som gir hull ved flere replikaer eller restart.
model SamlCacheEntry {
  key       String   @id
  value     String
  expiresAt DateTime

  @@index([expiresAt])
}

// Engangskoder for gjenoppretting av 2FA. Bare bcrypt-hashen lagres, og hver
// kode kan brukes nøyaktig én gang (usedAt settes ved innlogging).
model TwoFactorRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
}

model Customer {
  id             String   @id @default(cuid())
  name           String
  customerNumber String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  orgNumber      String?
  brandColor     String?
  logoUrl        String?

  address    String?
  postalCode String?
  city       String?
  phone      String?
  email      String?
  notes      String?

  /// Sist kjente registerstatus fra Enhetsregisteret. Oppdateres av
  /// registervakten (`npm run registry:check`), ikke av skjemaet.
  registryStatus    String?
  registryCheckedAt DateTime?

  /// Myk sletting: raden beholdes for historikk/revisjon.
  deletedAt DateTime?
  deletedBy String?

  /// Satt når direkte identifikatorer er anonymisert etter en personvern-
  /// forespørsel. Idempotensen i slettetjenesten bygger på dette feltet;
  /// raden, id-ene og tjenestehistorikken beholdes.
  anonymisedAt DateTime?
  /// Administrator som utførte anonymiseringen. Selve revisjonsloggen er
  /// beviset; feltet gjør tilstanden synlig uten å slå opp loggen.
  anonymisedBy String?

  // Valgfri tilhørighet: hvilken avdeling og eventuelt hvilken montør som er
  // ansvarlig for kunden. Brukes blant annet i kundeportalen for å vise riktig
  // lokasjon og direkte kontaktinfo.
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  responsibleTechnicianId String?
  responsibleTechnician   User?   @relation("CustomerResponsibleTechnician", fields: [responsibleTechnicianId], references: [id], onDelete: SetNull)

  products         Product[]
  contracts        Contract[]
  workOrder        WorkOrder[]
  bookingRequests  BookingRequest[]
  sites            CustomerSite[]
  bookingHolds     BookingHold[]
  contacts         Contact[]
  comments         Comment[]
  attachments      CustomerAttachment[]
  maintenancePlans MaintenancePlan[]
  messageThreads   MessageThread[]
  documents        Document[]
  quotes           Quote[]
  invoices         Invoice[]
  accountingCustomers AccountingCustomer[]

  users User[]

  @@index([departmentId])
  @@index([responsibleTechnicianId])
  @@index([email])
  @@index([orgNumber])
  @@index([registryStatus])
  @@index([name])
  @@index([customerNumber])
  @@index([deletedAt])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Customer_name_trgm")
  @@index([city(ops: raw("gin_trgm_ops"))], type: Gin, map: "Customer_city_trgm")
}

/// Kundens fysiske adresse eller anlegg som en bestilling gjelder. Kunden kan
/// ha flere steder, men kundeportalen bruker bare det primære stedet som
/// standardvalg. Adressen lagres som et snapshot på bestillingen.
model CustomerSite {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  address    String?
  postalCode String?
  city       String?
  latitude   Float?
  longitude  Float?
  isPrimary  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  bookingRequests BookingRequest[]
  bookingHolds    BookingHold[]
  workOrders      WorkOrder[]
  products        Product[]

  @@unique([customerId, name])
  @@index([customerId])
  @@index([customerId, isPrimary])
}

model Contact {
  id         String   @id @default(cuid())
  name       String
  email      String?
  phone      String?
  role       String?
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  workOrder WorkOrder[]
  comments  Comment[]
  users     User[]
  contracts Contract[]

  /// Språket kontaktpersonen skal få SMS på. Standard er norsk.
  locale             String              @default("nb")
  messageThreads     MessageThread[]
  smsMessages        SmsMessage[]
  channelPreferences ChannelPreference[]
  portalDelegation   PortalDelegation?
  quotes              Quote[]
  invoices            Invoice[]

  @@index([customerId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Contact_name_trgm")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "Contact_email_trgm")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "Contact_phone_trgm")
}

/// Delegerte rettigheter for en kontaktperson som logger inn i kundeportalen.
/// En kontakt uten rad har full portaltilgang (bakoverkompatibelt); en rad med
/// `isActive = false` stenger portalen for den kontakten helt.
model PortalDelegation {
  id        String  @id @default(cuid())
  contactId String  @unique
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  canBook           Boolean @default(false)
  canViewDocuments  Boolean @default(false)
  canViewContracts  Boolean @default(false)
  canViewEquipment  Boolean @default(true)
  isActive          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([contactId, isActive])
}

/// Utstyrets driftstilstand. Retired er en historisk enhet som ikke lenger
/// skal få nye målinger eller vedlikeholdsplaner.
enum EquipmentStatus {
  ACTIVE
  OUT_OF_SERVICE
  RETIRED
}

/// Kategoritre for utstyr. Treet er enkelt å bygge ut (bygg → system → enhet),
/// men sykluser avvises av tjenestelaget, ikke bare av databasen.
model EquipmentCategory {
  id       String  @id @default(cuid())
  name     String
  parentId String?

  parent   EquipmentCategory?  @relation("EquipmentCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children EquipmentCategory[] @relation("EquipmentCategoryTree")
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([parentId])
  @@index([name])
}

// En enhet er en maskin/utstyr som står hos kunden, f.eks. en port, en pumpe
// eller et aggregat. Kunden kan ha mange enheter. Enheten kan i tillegg inngå
// i et hierarki (bygg → system → enhet) og ha målinger, garanti og QR-identitet.
model Product {
  id           String  @id @default(cuid())
  model        String
  serialNumber String?
  location     String?

  customerId    String
  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  workOrder     WorkOrder[]
  reportUnits   ReportUnit[]
  contractLines ContractLine[]
  quotes        Quote[]

  /// Fysisk sted der utstyret står. Tomt betyr kundens primære adresse.
  siteId String?
  site   CustomerSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  // Kategoritre og fysisk/teknisk hierarki. To ulike trær med hvert sitt formål:
  // kategorien sier hva utstyret er, hierarkiet hvor det hører til.
  categoryId String?
  category   EquipmentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  parentId String?
  parent   Product?  @relation("EquipmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Product[] @relation("EquipmentHierarchy")

  status      EquipmentStatus @default(ACTIVE)
  criticality Int             @default(2) // 1 = kritisk, 2 = normal, 3 = lav
  meterUnit   String? // timer | km | sykluser

  installDate        DateTime? @db.Date
  warrantyUntil      DateTime? @db.Date
  /// Satt når garantiutløp er varslet, slik at varselet bare sendes én gang.
  warrantyNotifiedAt DateTime?

  /// Tilfeldig token i QR-etiketten. Roteres når etiketten skal sperres.
  qrToken String? @unique

  meterReadings    MeterReading[]
  maintenancePlans MaintenancePlan[]
  documents        Document[]
  qrCodes          EquipmentQrCode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([customerId])
  @@index([customerId, serialNumber])
  @@index([siteId])
  @@index([categoryId])
  @@index([parentId])
  @@index([status])
  @@index([warrantyUntil])
  @@index([model(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_model_trgm")
  @@index([serialNumber(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_serialNumber_trgm")
  @@index([location(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_location_trgm")
}

/// Hvor en eksisterende QR-kode kommer fra. MANUAL er limt inn eller skrevet,
/// SCAN er lest med kameraet i felt, IMPORT er hentet fra en kundepakke.
enum EquipmentQrCodeSource {
  MANUAL
  SCAN
  IMPORT
}

/// QR-kode som allerede sitter fysisk på utstyret fra et annet system.
///
/// `value` bevarer den eksakte strengen slik den skal vises, mens
/// `normalizedValue` er trimmet for mellomrom og usynlige tegn og har global
/// unikhet. Sammenligningen er bevisst case-sensitiv: QR-verdier er
/// case-sensitive, og to koder som bare skiller seg i store/små bokstaver er
/// normalt to forskjellige fysiske koder.
model EquipmentQrCode {
  id              String                @id @default(cuid())
  productId       String
  product         Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  value           String
  normalizedValue String                @unique
  label           String?
  source          EquipmentQrCodeSource @default(MANUAL)
  createdAt       DateTime              @default(now())
  createdById     String?
  createdBy       User?                 @relation("EquipmentQrCodeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lastScannedAt   DateTime?

  @@index([productId])
}

/// Livssyklusen til en serviceavtale. `isActive` beholdes som et avledet
/// felt for eldre kode og er alltid `status = ACTIVE`.
enum ContractStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
  TERMINATED
}

enum RenewalMode {
  AUTO
  MANUAL
}

/// En måling fra utstyret. `source` er MANUAL | VISIT | IMPORT. Verdien er
/// desimal fordi både timer, kilometer og sykluser kan ha desimaler.
model MeterReading {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  value     Decimal  @db.Decimal(12, 2)
  readAt    DateTime
  source    String   @default("MANUAL")
  visitId   String?
  visit     Visit?   @relation(fields: [visitId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  note      String?
  createdAt DateTime @default(now())

  @@index([productId, readAt])
  @@index([visitId])
  @@index([userId])
}

enum MaintenanceTrigger {
  CALENDAR
  METER
}

/// En vedlikeholdsplan genererer forebyggende oppdrag enten på kalender
/// (`intervalMonths`) eller når en måler passerer en terskel (`meterInterval`).
model MaintenancePlan {
  id             String             @id @default(cuid())
  title          String
  trigger        MaintenanceTrigger
  /// CALENDAR: antall måneder mellom hver forekomst.
  intervalMonths Int?
  /// METER: antall enheter mellom hvert genererte oppdrag.
  meterInterval  Decimal?           @db.Decimal(12, 2)
  /// Hvor mange dager før forfall oppdraget kan genereres.
  leadDays       Int                @default(14)
  nextDueDate    DateTime?          @db.Date
  /// Siste målerverdi som er brukt som terskelgrunnlag. Null betyr at neste
  /// måling setter utgangspunktet uten å lage et oppdrag.
  lastMeterValue Decimal?           @db.Decimal(12, 2)
  isActive       Boolean            @default(true)

  productId    String?
  product      Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  customerId   String
  customer     Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  templateId   String?
  template     Template?  @relation(fields: [templateId], references: [id], onDelete: SetNull)

  occurrences MaintenancePlanOccurrence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([nextDueDate, isActive])
  @@index([customerId])
  @@index([productId])
  @@index([departmentId])
}

/// Én forekomst av en plan. `@@unique([planId, dueDate])` er den siste skansen
/// mot dobbeltgenerering; tjenestelaget tar i tillegg en advisory lock.
model MaintenancePlanOccurrence {
  id          String          @id @default(cuid())
  planId      String
  plan        MaintenancePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  dueDate     DateTime        @db.Date
  /// PENDING | GENERATED | SKIPPED
  status      String          @default("PENDING")
  workOrderId String?         @unique
  workOrder   WorkOrder?      @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  /// Målerverdien som utløste en METER-forekomst.
  meterValue  Decimal?        @db.Decimal(12, 2)
  createdAt   DateTime        @default(now())

  @@unique([planId, dueDate])
  @@index([status, dueDate])
}

// En serviceavtale beskriver en gjentagende service for en kunde. Hver gang
// neste service faller forfaller, opprettes et nytt oppdrag med kundedataene
// ferdig utfylt. Sjekklisten er en mal som festes til oppdraget, men selve
// rapporten er alltid ny og tom – den forrige rapporten legges ved som PDF.
model Contract {
  id                String         @id @default(cuid())
  title             String
  /// Menneskelig, valgfri avtalenummer. Unik når den er satt.
  contractNumber    String?        @unique
  /// Intervall i måneder. Bare 3, 6, 12 og 24 er gyldige.
  intervalMonths    Int
  startDate         DateTime       @db.Date
  /// Siste gyldige dag. Tom betyr tidsubegrenset.
  endDate           DateTime?      @db.Date
  /// Neste dato det skal opprettes et oppdrag for.
  nextServiceDate   DateTime       @db.Date
  status            ContractStatus @default(ACTIVE)
  /// Avledet av `status`; beholdes for eksisterende spørringer og backfill.
  isActive          Boolean        @default(true)
  renewalMode       RenewalMode    @default(MANUAL)
  /// Antall dager før utløp en manuell fornyelse bør varsles om.
  noticeDays        Int            @default(30)
  /// Referanseverdi for prisjustering. Ingen fakturering eller beregning.
  indexationPercent Decimal?       @db.Decimal(5, 2)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  // Avtalen eier avdelingen som de genererte oppdragene havner i.
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  // Kontaktpersonen som skal stå på de genererte oppdragene. Tom betyr at
  // kundens første kontaktperson brukes.
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  // Sjekklistemalen som festes til hvert genererte oppdrag.
  templateId String?
  template   Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  // SLA-avtalen og prislisten er referanser. Prislisten brukes bare til
  // visning; systemet har ingen faktureringssemantikk.
  slaPolicyId String?
  slaPolicy   SlaPolicy? @relation(fields: [slaPolicyId], references: [id], onDelete: SetNull)
  priceListId String?
  priceList   PriceList? @relation(fields: [priceListId], references: [id], onDelete: SetNull)

  lines      ContractLine[]
  workOrders WorkOrder[]
  quotes     Quote[]

  @@index([customerId])
  @@index([departmentId])
  @@index([nextServiceDate])
  @@index([isActive, nextServiceDate])
  @@index([status, endDate])
  @@index([slaPolicyId])
  @@index([priceListId])
}

/// Dekningen en avtale gir. `productId = null` betyr alt utstyr hos kunden.
model ContractLine {
  id                String   @id @default(cuid())
  contractId        String
  contract          Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  scope             String   @default("")
  visitsPerYear     Int?
  responseMinutes   Int?
  resolutionMinutes Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  @@index([contractId])
  @@index([productId])
}

/// Prisliste er referansedata for visning. Ingen beløp brukes i fakturering.
model PriceList {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  items     PriceListItem[]
  contracts Contract[]

  @@index([isActive])
}

model PriceListItem {
  id          String    @id @default(cuid())
  priceListId String
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  code        String
  label       String
  unit        String
  /// Visningsbeløp. Systemet beregner eller fakturerer aldri dette.
  amount      Decimal   @db.Decimal(12, 2)

  @@unique([priceListId, code])
  @@index([priceListId])
}

/// Svar- og løsningsfrist for oppdrag. En avdeling kan ha flere policyer;
/// avtalen peker på den som gjelder.
model SlaPolicy {
  id                String      @id @default(cuid())
  name              String
  departmentId      String?
  department        Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  responseMinutes   Int
  resolutionMinutes Int
  businessHoursOnly Boolean     @default(true)
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @default(now()) @updatedAt

  contracts Contract[]
  clocks    SlaClock[]

  @@index([departmentId])
  @@index([isActive])
}

enum SlaState {
  ON_TRACK
  AT_RISK
  BREACHED
  MET
  CANCELLED
}

/// Én klokke per oppdrag og policy. Tidspunktene er absolutte og regnet ut
/// gjennom `src/server/business-hours.ts`, også over sommertid.
model SlaClock {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  policyId    String
  policy      SlaPolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)
  startedAt   DateTime
  respondBy   DateTime
  resolveBy   DateTime
  respondedAt DateTime?
  resolvedAt  DateTime?
  state       SlaState  @default(ON_TRACK)
  breachedAt  DateTime?

  @@unique([workOrderId, policyId])
  @@index([state, resolveBy])
  @@index([workOrderId])
  @@index([policyId])
}

/// Én kjøring av den automatiske SLA-oppryddingen. Raden brukes av
/// driftsmålinger og alarmen for «siste kjøring»; selve kanselleringene har
/// egne revisjonslogger på hver klokke.
model SlaCleanupRun {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  /// RUNNING, SUCCEEDED eller FAILED.
  status     String    @default("RUNNING")
  dryRun     Boolean   @default(false)
  scanned    Int       @default(0)
  kept       Int       @default(0)
  cancelled  Int       @default(0)
  error      String?

  @@index([startedAt])
  @@index([status, startedAt])
}

/// Åpningstider per ukedag, minutter fra midnatt i Europe/Oslo. 0 = mandag.
model BusinessHours {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  weekday      Int
  openMinute   Int
  closeMinute  Int

  @@unique([departmentId, weekday])
  @@index([departmentId])
}

/// Helligdag som lukker SLA-klokken. Uten avdeling gjelder den alle.
model Holiday {
  id           String      @id @default(cuid())
  date         DateTime    @db.Date
  name         String
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([date, departmentId])
  @@index([date])
  @@index([departmentId])
}

model CustomerAttachment {
  id        String   @id @default(cuid())
  fileName  String
  dataUrl   String
  createdAt DateTime @default(now())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

/// Overordnet kategori for en mal. HMS-maler vises i HMS-flaten og på
/// oppdragets HMS-dokumentasjon, service-maler i den vanlige sjekklisten.
enum TemplateCategory {
  SERVICE
  HMS
}

/// Undertype for HMS-skjemaer. Styrer gruppering i HMS-biblioteket.
enum HmsFormType {
  GENERAL
  SJA
  HOT_WORK
  INTERNAL_CONTROL
  DEVIATION
  SAFETY_ROUND
  WRITTEN_INSTRUCTION
}

enum WorkStatus {
  PLANNED
  IN_PROGRESS
  WAITING
  COMPLETED
  PENDING
  CANCELLED
  OPEN
}

/// Hvordan en oppdragsstatus oppfører seg i lister, rapporter og lukkelogikk.
/// Administratoren kan endre dette uten å endre selve statusverdiene.
enum WorkOrderStatusCategory {
  OPEN
  PLANNED
  CLOSED
}

/// Installationsspesifikk funksjon for hver innebygde oppdragsstatus.
model WorkOrderStatusSetting {
  status      WorkStatus             @id
  category    WorkOrderStatusCategory @default(OPEN)
  sortOrder   Int                    @default(0)
  isActive    Boolean                @default(true)
  updatedAt   DateTime               @updatedAt
  updatedById String?
}

/// Standard status for nye oppdrag. PENDING betyr «åpen, venter på planlegging».
model WorkOrderSettings {
  id            String     @id @default("default")
  defaultStatus WorkStatus @default(PENDING)
  updatedAt     DateTime   @updatedAt
  updatedById   String?
}

/// Kundens bestilling fra kundeportalen. Én bestilling hører til nøyaktig ett
/// oppdrag, og beholder ønsket tid, utstyr og kontaktperson som et snapshot.
enum BookingRequestStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum BookingEventType {
  CREATED
  CONFIRMED
  RESCHEDULED
  CANCELLED
  EXPIRED
}

/// Status for en planlagt visitt. Flyten er PLANNED → ASSIGNED → EN_ROUTE →
/// ON_SITE → DONE, med CANCELLED som alternativ før visitten er fullført.
/// DONE og CANCELLED er lukkede tilstander.
enum VisitStatus {
  PLANNED
  ASSIGNED
  EN_ROUTE
  ON_SITE
  DONE
  CANCELLED
}

model WorkOrder {
  id                    String     @id @default(cuid())
  title                 String
  /// Menneskelig, unik referanse kunden kan oppgi og som kan søkes opp.
  /// Ordinære oppdrag bruker O-YYMMDD-XXXXXXXX; kundebestillinger beholder
  /// sin B-YYMMDD-XXXXXX-referanse.
  reference             String     @unique
  /// Eksternt ordrenummer fra kundens system.
  orderNumber           String?
  /// Normalisert ordrenummer for duplikatkontroll/søk.
  orderNumberNormalized String?
  /// Unik nøkkel for automatisk opprettet utbedringsoppdrag.
  deviationSourceKey    String?    @unique
  description           String?
  /// Arbeidssted for dette oppdraget. Tomt betyr kundens adresse.
  address               String?
  postalCode            String?
  city                  String?
  /// Geokodede koordinater for arbeidsstedet, med hash av adressegrunnlaget.
  latitude              Float?
  longitude             Float?
  geoAddressHash        String?
  scheduledFor          DateTime?  @db.Date
  /// Siste dag oppdraget varer (inklusiv). Tom betyr éndagsoppdrag.
  scheduledTo           DateTime?  @db.Date
  status                WorkStatus @default(PENDING)
  creatorName           String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @default(now()) @updatedAt
  /// Myk sletting: oppdraget skjules fra lister, men kan gjenopprettes.
  deletedAt             DateTime?
  deletedBy             String?
  /// Bevaringsplikt: hindrer automatisk hard sletting etter fristen.
  legalHold             Boolean    @default(false)

  technicians User[] @relation("WorkOrderTechnicians")

  // Oppdraget tilhører én avdeling, og er bare synlig for ansatte der.
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  /// Fysisk sted for oppdraget. Tomt betyr kundens primære adresse.
  siteId String?
  site   CustomerSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  attachments Attachment[]

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  // Satt når oppdraget er generert fra en serviceavtale.
  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  templates      Template[]      @relation("WorkOrderTemplates")
  reports        Report[]
  workComments   Comment[]       @relation("WorkOrderComments")
  tags           Tag[]           @relation("WorkOrderTags")
  reportDrafts   ReportDraft[]
  bookingRequest BookingRequest?

  // Planlagte visiter og påkrevd kompetanse. `scheduledFor`/`scheduledTo`
  // speiler fortsatt min/maks av visitene for eksisterende konsumenter.
  visits            Visit[]
  skillRequirements WorkOrderSkill[]
  slaClocks         SlaClock[]
  trackingLinks     TrackingLink[]
  reviews           Review[]
  messageThreads    MessageThread[]
  smsMessages       SmsMessage[]
  quotes            Quote[]
  invoices          Invoice[]

  /// Forekomst av en vedlikeholdsplan som genererte dette oppdraget.
  maintenanceOccurrence MaintenancePlanOccurrence?

  /// Innmeldt ordre fra et eksternt ordresystem. Unik per kilde og ekstern id.
  externalOrder ExternalOrder?

  @@unique([departmentId, orderNumberNormalized])
  // Hindrer at to samtidige kjøringer lager samme serviceavtale-oppdrag.
  @@unique([contractId, scheduledFor])
  @@index([departmentId])
  @@index([customerId])
  @@index([siteId])
  @@index([status])
  @@index([scheduledFor])
  @@index([contractId])
  @@index([orderNumber])
  @@index([orderNumberNormalized])
  @@index([scheduledTo])
  @@index([deletedAt])
  @@index([departmentId, status, scheduledFor])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "WorkOrder_title_trgm")
}

/// Idempotent referanse for en ordre mottatt fra et eksternt ordresystem.
/// `(source, externalId)` er alltid idempotensnøkkelen. `idempotencyKey` er en
/// valgfri sekundær nøkkel fra `Idempotency-Key`-headeren. Selve payloaden og
/// linjene lagres som JSON, slik at en replayed forespørsel kan sammenlignes og
/// historikken er lesbar uten å følge relasjoner.
model ExternalOrder {
  id             String    @id @default(cuid())
  source         String
  externalId     String
  idempotencyKey String?
  workOrderId    String    @unique
  workOrder      WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  priority       String?
  /// SHA-256 av den normaliserte forespørselen. Ulike data på samme nøkkel
  /// avvises med 409 i stedet for å overskrive en eksisterende ordre.
  requestHash    String
  payload        Json?
  lines          Json?
  receivedAt     DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  @@unique([source, externalId])
  @@unique([source, idempotencyKey])
  @@index([workOrderId])
  @@index([source, receivedAt])
}

/// En planlagt, tildelbar tidsblokk i et oppdrag. Et oppdrag kan ha flere
/// visiter; `WorkOrder.scheduledFor`/`scheduledTo` er avledet fra disse.
/// Tidsstemplene er absolutte tidspunkt (timestamptz), slik at sommertid
/// håndteres riktig uten å endre veggklokketiden i databasen.
model Visit {
  id          String      @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder   @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  sequence    Int         @default(0)
  /// Manuell rekkefølge i montørens rute for dagen. Null betyr automatisk.
  routeSequence Int?
  startsAt    DateTime    @db.Timestamptz(3)
  endsAt      DateTime    @db.Timestamptz(3)
  allDay      Boolean     @default(false)
  status      VisitStatus @default(PLANNED)
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt

  /// Eksplisitte statustidspunkt. De settes atomisk sammen med statusen i
  /// `setVisitStatus`, slik at rapportering og ETA ikke må utlede tid fra
  /// `updatedAt` (som også endres av notater og flytting).
  enRouteAt DateTime? @db.Timestamptz(3)
  onSiteAt  DateTime? @db.Timestamptz(3)
  doneAt    DateTime? @db.Timestamptz(3)
  /// Når retur-/viderekjøringen etter fullført arbeid er avsluttet. Settes av
  /// «Avslutt kjøring» eller automatisk når neste visitt starter EN_ROUTE.
  travelFromEndedAt DateTime? @db.Timestamptz(3)
  /// Satt når lukkingen av oppdraget selv lukket eller kansellerte visitten.
  /// Gjenåpning gjenoppretter bare disse, slik at en visitt som ble kansellert
  /// manuelt («kunden var ikke hjemme») ikke vekkes til live igjen.
  autoClosedAt DateTime? @db.Timestamptz(3)

  technicians   VisitTechnician[]
  meterReadings MeterReading[]

  bookingRequest BookingRequest? @relation("BookingVisit")

  trackingLinks TrackingLink[]
  locationPings VisitLocationPing[]
  reviews       Review[]
  reminderDispatches ReminderDispatch[]

  @@index([workOrderId, startsAt])
  @@index([startsAt, endsAt])
  @@index([status])
}

model VisitTechnician {
  visitId String
  userId  String
  visit   Visit  @relation(fields: [visitId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([visitId, userId])
  @@index([userId])
}

/// Offentlig sporingslenke for én visitt. Bare SHA-256-hashen av det
/// 32-byte tilfeldige tokenet lagres; klarteksten vises én gang ved oppretting.
/// Lenken er gyldig til `expiresAt` (visittens slutt + 2 timer) og kan
/// tilbakekalles umiddelbart.
model TrackingLink {
  id        String @id @default(cuid())
  tokenHash String @unique

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  visitId String
  visit   Visit  @relation(fields: [visitId], references: [id], onDelete: Cascade)

  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime? @db.Timestamptz(3)

  @@index([visitId, revokedAt])
  @@index([workOrderId])
  @@index([expiresAt])
}

/// Posisjonsping fra montørens enhet mens visitten er EN_ROUTE. Radene er
/// korte leveår: en sveipende jobb sletter alt eldre enn 24 timer, og ingen
/// historikk eksponeres offentlig. Koordinatene brukes bare til å beregne ETA.
model VisitLocationPing {
  id         String   @id @default(cuid())
  visitId    String
  visit      Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  latitude   Float
  longitude  Float
  recordedAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([visitId, recordedAt])
  @@index([recordedAt])
  @@index([userId])
}

/// Kundeomtale etter fullført visitt. Én rad per visitt (`visitId` unik), slik
/// at gjentatte forespørsler er idempotente. Tokenet lagres bare som hash, og
/// innsending er atomisk begrenset til én gang (`submittedAt`).
model Review {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  visitId     String?   @unique
  visit       Visit?    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  score       Int?
  comment     String?
  requestedAt DateTime? @db.Timestamptz(3)
  submittedAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now())

  @@index([workOrderId, submittedAt])
  @@index([submittedAt, score])
}

/// Kompetanse som kan kreves av et oppdrag og tildeles en montør.
model Skill {
  id       String  @id @default(cuid())
  key      String  @unique
  label    String
  category String?

  users      UserSkill[]
  workOrders WorkOrderSkill[]
}

model UserSkill {
  userId     String
  skillId    String
  level      Int?
  validUntil DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
  @@index([skillId])
}

model WorkOrderSkill {
  workOrderId String
  skillId     String
  mandatory   Boolean @default(true)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  skill     Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([workOrderId, skillId])
  @@index([skillId])
}

/// Gjentakende ukentlig arbeidstid. Minutter fra midnatt, lokal tid
/// (Europe/Oslo), med 0 = mandag … 6 = søndag.
model UserAvailability {
  id          String @id @default(cuid())
  userId      String
  weekday     Int
  startMinute Int
  endMinute   Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, weekday])
}

/// Fravær som blokkerer tildeling i en periode. `kind` er FERIE | SYKDOM |
/// KURS | ANNET.
model Absence {
  id       String   @id @default(cuid())
  userId   String
  startsAt DateTime @db.Timestamptz(3)
  endsAt   DateTime @db.Timestamptz(3)
  kind     String
  note     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startsAt, endsAt])
}

/// Geografisk ansvarsområde for en avdeling. Postnummerprefikser og
/// kommunekoder brukes til å foreslå riktig montør; radius er et supplement
/// når adressen bare har koordinater.
model Territory {
  id           String @id @default(cuid())
  name         String
  departmentId String

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  /// Postnummerprefikser, f.eks. «01», «02». Tom liste betyr ingen begrensning.
  postalPrefixes    String[] @default([])
  /// Kommunekoder (SSB), f.eks. «0301». Tom liste betyr ingen begrensning.
  municipalityCodes String[] @default([])
  radiusKm          Int?
  centerLat         Float?
  centerLng         Float?
  isActive          Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([departmentId, name])
  @@index([departmentId, isActive])
}

/// Planlagt kapasitet for en avdeling på en dato. Uten `technicianId` gjelder
/// raden hele avdelingen; med en montør overstyrer den avdelingskapasiteten.
/// En delvis unik indeks i migreringen hindrer to avdelingsrader for samme dag,
/// fordi PostgreSQL ellers tillater flere NULL-verdier i en vanlig unik nøkkel.
model CapacityPlan {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  date         DateTime @db.Date
  technicianId String?
  technician   User?    @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  /// Tilgjengelige minutter denne dagen. 0 er en bevisst stengt dag.
  capacityMinutes Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([departmentId, date, technicianId])
  @@index([departmentId, date])
  @@index([technicianId, date])
}

/// Rekkefølgen og vektene dispatch-motoren bruker når den rangerer montører.
/// `mode` er SKILLS | DISTANCE | EARLIEST | CUSTOM; `weights` er et JSON-objekt
/// med tall for skills, distance, travel, free, sla og load.
model AssignmentPolicy {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  mode     String  @default("SKILLS")
  weights  Json    @default("{}")
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId, isActive])
}

/// Kundens bestillingsforespørsel. Oppdraget er den operative saken; denne
/// raden bevarer det kunden faktisk ba om, slik at ønsket tid og historikk
/// ikke endres når kontoret planlegger.
model BookingRequest {
  id          String    @id @default(cuid())
  /// Kort, menneskelig referanse kunden kan oppgi til kontoret.
  reference   String    @unique
  workOrderId String    @unique
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// Ønsket startdato (kalenderdato) og tidsvindu, lagret som HH:mm.
  requestedDate DateTime @db.Date
  requestedFrom String
  requestedTo   String

  /// Tjenestetypen kunden valgte i den nye slotvelgeren. Eldre bestillinger
  /// (og kontorets manuelle forespørsler) kan mangle denne.
  serviceType String?

  /// Stedet bestillingen gjelder. Adressen kopieres også til oppdraget, slik
  /// at senere endringer i kundens stedsregister ikke flytter historikken.
  siteId String?
  site   CustomerSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  /// Visitten som ble opprettet da bestillingen ble bekreftet. Én bestilling
  /// peker på nøyaktig én visitt; eldre forespørsler kan mangle den.
  visitId String? @unique
  visit   Visit?  @relation("BookingVisit", fields: [visitId], references: [id], onDelete: SetNull)

  /// Utstyr og tekniker er snapshots fra bestillingstidspunktet. Id-ene er
  /// validert mot kundens egne enheter og avdelingens aktive ansatte.
  equipmentId             String?
  equipmentLabel          String?
  preferredTechnicianId   String?
  preferredTechnicianName String?

  contactName  String
  contactPhone String

  status      BookingRequestStatus @default(PENDING)
  cancelledAt DateTime?
  confirmedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  events BookingRequestEvent[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([siteId])
}

/// Synlig endringshistorikk for en bestilling. Hver rad er et uforanderlig
/// hendelsesøyeblikk; selve bestillingen viser alltid gjeldende ønsket tid.
model BookingRequestEvent {
  id               String         @id @default(cuid())
  bookingRequestId String
  bookingRequest   BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)

  type    BookingEventType
  /// Kort forklaring til kunden, f.eks. «Ny tid forespurt».
  message String?

  requestedDate DateTime? @db.Date
  requestedFrom String?
  requestedTo   String?

  actorName String?
  createdAt DateTime @default(now())

  @@index([bookingRequestId, createdAt])
}

/// Kortvarig reservasjon av en ledig time mens kunden fyller ut skjemaet.
/// Raden blokkerer timen i tilgjengelighetsberegningen til den utløper eller
/// konsumeres av en bekreftet bestilling. Utløpte rader ryddes av jobbworkeren.
model BookingHold {
  id    String @id @default(cuid())
  /// Uforutsigbart engangstoken som klienten sender tilbake ved bekreftelse.
  token String @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  siteId String?
  site   CustomerSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  technicianId String?
  technician   User?   @relation("BookingHoldTechnician", fields: [technicianId], references: [id], onDelete: SetNull)

  startsAt DateTime @db.Timestamptz(3)
  endsAt   DateTime @db.Timestamptz(3)

  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now())

  @@index([expiresAt])
  @@index([customerId, expiresAt])
  @@index([technicianId, startsAt, endsAt])
  @@index([siteId])
}

model Tag {
  id         String      @id @default(cuid())
  name       String      @unique
  color      String      @default("#3b82f6")
  workOrders WorkOrder[] @relation("WorkOrderTags")
}

model DocumentTag {
  id        String     @id @default(cuid())
  name      String     @unique
  color     String     @default("#3b82f6")
  documents Document[] @relation("DocumentTagRelation")
}

model DocumentFolder {
  id        String           @id @default(cuid())
  name      String
  parentId  String?
  parent    DocumentFolder?  @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  DocumentFolder[] @relation("FolderChildren")
  documents Document[]

  @@index([parentId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "DocumentFolder_name_trgm")
}

model Document {
  id          String  @id @default(cuid())
  title       String
  description String?
  fileName    String
  filePath    String
  fileSize    Int     @default(0)
  mimeType    String  @default("application/pdf")

  // Ekstrahert tekst fra PDF for fulltekst-søk. pageTexts er JSON-array
  // [{page: number, text: string}] for side-spesifikk navigasjon.
  contentText String?
  pageTexts   String?

  // PostgreSQL-generert tsvector for fulltekst-søk. Prisma kan ikke uttrykke
  // GENERATED-kolonnen, så den opprettes i migreringen.
  searchTsv Unsupported("tsvector")?

  folderId String?
  folder   DocumentFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  // Eierskap for kundedokumenter. Den globale dokumentmappen kan inneholde
  // dokumenter uten eier; de eksporteres aldri som en del av en kundepakke.
  // `customerId`/`productId` settes bare når eierskapet er kjent, aldri gjettet
  // fra tittel eller filnavn.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  productId  String?
  product    Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  tags DocumentTag[] @relation("DocumentTagRelation")

  uploadedBy String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  deletedBy  String?

  versions DocumentVersion[]

  @@index([folderId])
  @@index([customerId])
  @@index([productId])
  @@index([title])
  @@index([deletedAt])
  @@index([searchTsv], type: Gin, map: "Document_searchTsv")
}

// Tidligere filversjoner av et dokument. Når filen byttes ut, beholdes den
// gamle filen her slik at den kan lastes ned igjen senere.
model DocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  fileName String
  filePath String
  fileSize Int    @default(0)
  mimeType String @default("application/pdf")

  createdBy String?
  createdAt DateTime @default(now())

  @@index([documentId])
}

model Report {
  id          String   @id @default(cuid())
  dataJson    String
  comments    String?
  completedAt DateTime @default(now())

  // Signaturer. Tekniker og kunde signerer hver for seg, og begge er valgfrie
  // (en jobb kan signeres av bare én av partene).
  technicianSignatureUrl String?
  technicianName         String?
  customerSignatureUrl   String?
  customerName           String?

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  templateId String?
  template   Template? @relation(fields: [templateId], references: [id])

  // Øyeblikksbilde av malen da rapporten ble signert, slik at senere endringer
  // i malen ikke endrer en allerede signert rapport.
  templateTitle        String?
  /// Rapportens visningsnavn, kopiert fra malen da rapporten ble laget.
  name                 String?
  /// Automatisk rapportnummer for HMS-rapporter, f.eks. abc1234.
  reportNumber         String?          @unique
  /// Om rapporten har enheter. Snapshot fra malen.
  requiresUnits        Boolean          @default(true)
  /// Kategori og HMS-type frosset ved signering.
  templateCategory     TemplateCategory @default(SERVICE)
  hmsType              HmsFormType?
  templateSnapshotJson String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Rapporten låses automatisk når den er fylt ut, og kan ikke endres igjen før
  // en administrator låser den opp. Det hindrer at en signert rapport endres i
  // ettertid – noe som er viktig for sporbarheten.
  isLocked     Boolean   @default(false)
  lockedAt     DateTime?
  lockedByName String?

  // Cache for generert PDF. pdfHash beskriver innholdet PDF-en ble laget fra,
  // slik at den kan brukes på nytt til rapporten endres.
  pdfUrl         String?
  pdfHash        String?
  pdfGeneratedAt DateTime?

  // Kundeportalens kvittering på at rapporten er mottatt.
  customerAcknowledgedAt      DateTime?
  customerAcknowledgedBy      String?
  customerAcknowledgedComment String?

  /// Revisjonsnummer. Økes for hver endring som lagres som revisjon.
  revision Int @default(0)

  deletedAt DateTime?
  deletedBy String?
  /// Bevaringsplikt: hindrer automatisk hard sletting etter fristen.
  legalHold Boolean   @default(false)
  /// Satt når kundens direkte identifikatorer er fjernet fra rapportens
  /// strukturerte felt. En allerede signert PDF bevares uendret som
  /// tjenestebevis og kan derfor fortsatt inneholde opprinnelige data.
  customerDataRedactedAt DateTime?

  units     ReportUnit[]
  revisions ReportRevision[]
  invoices  Invoice[]

  @@unique([workOrderId, templateId])
  @@index([workOrderId])
  @@index([completedAt])
  @@index([workOrderId, createdAt])
  @@index([deletedAt])
  @@index([reportNumber(ops: raw("gin_trgm_ops"))], type: Gin, map: "Report_reportNumber_trgm")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Report_name_trgm")
  @@index([templateTitle(ops: raw("gin_trgm_ops"))], type: Gin, map: "Report_templateTitle_trgm")
}

/// Uforanderlig øyeblikksbilde av en rapport før en endring. Signerte rapporter
/// skal alltid kunne rekonstrueres, selv om de låses opp og endres senere.
model ReportRevision {
  id                          String           @id @default(cuid())
  reportId                    String
  report                      Report           @relation(fields: [reportId], references: [id], onDelete: Cascade)
  revision                    Int
  dataJson                    String
  unitsJson                   String
  comments                    String?
  templateTitle               String?
  name                        String?
  /// Rapportnummeret rapporten hadde da revisjonen ble laget.
  reportNumber                String?
  requiresUnits               Boolean          @default(true)
  templateCategory            TemplateCategory @default(SERVICE)
  hmsType                     HmsFormType?
  completedAt                 DateTime?
  templateSnapshotJson        String?
  technicianSignatureUrl      String?
  customerSignatureUrl        String?
  technicianName              String?
  customerName                String?
  customerAcknowledgedAt      DateTime?
  customerAcknowledgedBy      String?
  customerAcknowledgedComment String?
  reason                      String?
  createdById                 String?
  createdAt                   DateTime         @default(now())

  @@unique([reportId, revision])
  @@index([reportId, createdAt])
}

// Én enhet som inngår i en rapport. Feltene er øyeblikksbilder av enheten slik
// den var da rapporten ble skrevet, slik at rapporten forblir lesbar selv om
// enheten endres eller slettes på kundekortet senere.
model ReportUnit {
  id           String  @id @default(cuid())
  label        String
  serialNumber String?
  location     String?

  // GODKJENT | AVVIK – samme verdier som hovedresultatet.
  status      String  @default("GODKJENT")
  answersJson String  @default("{}")
  comment     String?

  reportId String
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([reportId])
  @@index([productId])
}

// Midlertidig lagring (kladd) av en sjekkliste. Én kladd per bruker, oppdrag og
// mal, slik at flere teknikere kan fylle ut samme sjekkliste uten å overskrive
// hverandre. Kladden slettes når rapporten lagres.
model ReportDraft {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  templateId  String
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  dataJson      String
  updatedByName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workOrderId, templateId, userId])
  @@index([workOrderId])
  @@index([userId])
}

model Template {
  id               String            @id @default(cuid())
  title            String
  /// Navnet som vises på produserte rapporter/PDF. Tomt = bruk title.
  reportName       String?
  /// Kort beskrivelse til malbiblioteket.
  description      String?
  /// SERVICE = vanlig sjekkliste, HMS = HMS-dokumentasjon.
  category         TemplateCategory  @default(SERVICE)
  /// Undertype når category = HMS.
  hmsType          HmsFormType?
  /// Om rapporten skal knyttes til enheter. Kan slås av per mal.
  requiresUnits    Boolean           @default(true)
  fieldsJson       String
  reports          Report[]
  workOrder        WorkOrder[]       @relation("WorkOrderTemplates")
  contracts        Contract[]
  maintenancePlans MaintenancePlan[]

  @@index([category, hmsType])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Template_title_trgm")
}

model Attachment {
  id       String @id @default(cuid())
  fileName String
  dataUrl  String

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
}

// Metadata for opplastede filer, slik at /uploads kan kreve tilgang per fil.
// Selve filen ligger på disk med et tilfeldig navn (storedName).
model Upload {
  id           String @id @default(cuid())
  storedName   String @unique
  originalName String
  mimeType     String
  size         Int    @default(0)

  // WORK_ORDER | CUSTOMER | DOCUMENT | USER
  ownerType    String
  ownerId      String?
  departmentId String?
  customerId   String?
  uploadedById String?

  /// SHA-256 av filinnholdet, brukt til deduplisering av kladdesignaturer.
  contentHash String?

  createdAt DateTime @default(now())

  @@index([ownerType, ownerId])
  @@index([departmentId])
  @@index([uploadedById])
  @@index([contentHash])
}

/// Kortlevd reservering av opplastingskvote. Raden opprettes før filen skrives
/// til den endelige mappen og slettes når `Upload`-raden er skrevet eller
/// opplastingen er avvist. Da teller samtidige opplastinger mot kvoten selv om
/// de ennå ikke har fått en `Upload`-rad.
///
/// Utløpte rader ignoreres i kvoteberegningen og ryddes av cronjobben, slik at
/// en krasjet prosess ikke låser kvoten permanent.
model UploadQuotaReservation {
  id         String   @id @default(cuid())
  userId     String
  customerId String?
  size       Int
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  @@index([userId, expiresAt])
  @@index([customerId, expiresAt])
  @@index([expiresAt])
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

// Vedvarende jobbkø for PDF-tekst og OCR. Erstatter den in-memory køen, slik
// at jobber overlever restart og kan kjøres av flere instanser.
model DocumentJob {
  id         String    @id @default(cuid())
  documentId String?
  /// PDF_TEXT | PDF_OCR
  type       String
  status     JobStatus @default(PENDING)
  attempts   Int       @default(0)
  runAt      DateTime  @default(now())
  lockedAt   DateTime?
  lastError  String?
  createdAt  DateTime  @default(now())

  @@index([status, runAt])
}

// Delt teller for rate limiting. Erstatter in-memory-telleren der flere
// instanser må se samme grense (innlogging, passordnullstilling, PDF, søk).
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

/// Database-fallback for cache når Redis ikke er konfigurert. Verdien er JSON
/// som tekst, slik at modellen er driver-uavhengig. Radene har TTL og ryddes av
/// jobbworkeren; Redis-nøkler bruker Redis sin egen TTL.
model InfraCache {
  key       String   @id
  value     String
  expiresAt DateTime

  @@index([expiresAt])
}

model AuditLog {
  id String @id @default(cuid())
  /// Monoton rekkefølge. Hash-kjeden følger denne, ikke tidspunktet, slik at
  /// to hendelser i samme millisekund fortsatt får en entydig rekkefølge.
  seq        Int      @unique @default(autoincrement())
  entityType String
  entityId   String
  action     String
  userName   String
  actorId    String?
  /// Avdelingen hendelsen skjedde i. Brukes til avdelingssperret visning og
  /// eksport; eldre rader kan mangle verdi og vises bare for administrator.
  departmentId String?
  metadata   Json?
  /// Hvem som utførte handlingen, hvorfra, og hvilket resultat den fikk.
  /// Feltene er valgfrie fordi eldre rader mangler dem.
  ip           String?
  userAgent    String?
  requestId    String?
  /// SUCCESS | DENIED | ERROR. Avviste og feilede handlinger er også hendelser.
  outcome      String   @default("SUCCESS")
  /// Stabil handlingskode, f.eks. `workorder.status.changed`. `action` forblir
  /// menneskelesbar tekst; koden brukes til filtrering og aggregering.
  actionCode   String?
  /// ACCOUNTING_5Y | SECURITY_1Y | OPS_90D | null (global standard).
  retentionClass String?
  /// Brukeren handlingen gjaldt, når den er en annen enn aktøren.
  targetUserId String?
  /// SHA-256 av forrige rad i kjeden (null for første rad).
  prevHash   String?
  /// SHA-256 av denne radens kanoniske innhold og `prevHash`.
  hash       String?
  createdAt  DateTime @default(now())

  @@index([entityType])
  @@index([entityId])
  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
  @@index([departmentId, createdAt])
  @@index([actionCode])
  @@index([outcome, createdAt])
  @@index([retentionClass, createdAt])
  @@index([hash])
  @@index([prevHash])
}

/// Konfigurasjon for revisjonsloggens oppbevaringstid. Én rad med id «default».
model AuditRetentionSetting {
  id            String   @id @default("default")
  /// Antall dager revisjonslogger beholdes før de kan purres. 0 = aldri.
  retentionDays Int      @default(365)
  updatedAt     DateTime @updatedAt
  updatedById   String?
}

/// Bevaringsplikt på revisjonslogger. Holdet ligger i en egen tabell fordi
/// selve revisjonsraden skal være uforanderlig: et hold er en markering, ikke
/// en endring av historikken. Et hold kan gjelde én logg eller en hel entitet.
model AuditHold {
  id          String    @id @default(cuid())
  auditLogId  String?
  entityType  String?
  entityId    String?
  reason      String
  createdById String?
  createdAt   DateTime  @default(now())
  releasedAt  DateTime?
  releasedById String?

  @@index([auditLogId])
  @@index([entityType, entityId])
  @@index([releasedAt])
}

/// Hash-verdier som er fjernet av retensjonsjobben. Uten disse ville en
/// verifisering se på neste rad som brutt, fordi `prevHash` peker på en rad som
/// er purret med vilje. Tombstones gjør at et kontrollert hull kan skilles fra
/// manipulering.
model AuditPurgedHash {
  hash     String   @id
  purgedAt DateTime @default(now())
  reason   String?
}

/// Vedvarende jobb for admin-eksport/import av en kundepakke.
///
/// Raden er både tilstand og revisjonsspor. JSON-feltene skal bare inneholde
/// id-er, antall, tilstander og stabile feilkoder – aldri kundedata, fritekst
/// eller filinnhold. Selve pakken ligger i en tilgangsbegrenset staging-mappe
/// og slettes når `expiresAt` er passert.
model CustomerTransferJob {
  id     String @id @default(cuid())
  actorId String
  /// EXPORT | IMPORT
  kind   String
  /// PENDING | QUEUED | RUNNING | STAGED | DRY_RUN | READY | COMPLETED | FAILED | ABORTED | EXPIRED
  status String @default("PENDING")

  /// SHA-256 av hele ZIP-filen. Bindes til forhåndsvisningen og bekreftelsen.
  packageChecksum String?
  sourceInstanceId String?
  schemaVersion    String?
  /// Valgte kundekilder (eksport) eller kilder i pakken (import), bare id-er.
  customerIdsJson  Json?
  /// Per-entitet antall og handlinger; ingen navn eller fritekst.
  countsJson       Json?
  /// Stabile feilkoder med JSON-peker. Ingen rå feilmeldinger eller PII.
  errorJson        Json?
  resultJson       Json?

  progressStage     String?
  progressProcessed Int @default(0)
  progressTotal     Int @default(0)

  /// Kortlevd, hash-et forhåndsvisningstoken bundet til aktør, jobb og sjekksum.
  previewTokenHash String?
  previewExpiresAt DateTime?
  /// Fingeravtrykk av målbasen ved forhåndsvisning, for å oppdage endringer.
  targetFingerprint String?

  /// Mappe under uploadDir()/.transfer. Slettes etter fullført/avbrutt/utløpt jobb.
  stagingPath String?
  expiresAt   DateTime?

  createdAt   DateTime @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime @updatedAt

  records CustomerTransferRecord[]

  @@index([actorId, createdAt])
  @@index([kind, status])
  @@index([expiresAt])
  @@index([packageChecksum])
}

/// Anvendt kilde→mål-mapping per importjobb.
///
/// Gjør det mulig å svare «allerede importert» ved en ny import av samme pakke
/// og bevarer proveniens uten å legge en `sourceId`-kolonne på hver domeneTabell.
model CustomerTransferRecord {
  id               String @id @default(cuid())
  jobId            String
  job              CustomerTransferJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sourceInstanceId String
  sourceEntityType String
  sourceId         String
  targetEntityType String
  targetId         String?
  /// CREATE | SKIP | UPDATE | CONFLICT | INVALID
  action           String
  createdAt        DateTime @default(now())

  @@unique([jobId, sourceInstanceId, sourceEntityType, sourceId])
  @@index([sourceInstanceId, sourceEntityType, sourceId])
  @@index([jobId, action])
}

model Notification {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// ASSIGNMENT | DATE_CHANGED | CANCELLED | REPORT_READY | BOOKING | CONTRACT_DUE | OVERDUE | MESSAGE
  type               String
  title              String
  /// Når varselet er laget med en oversettbar nøkkel, er dette nøkkelen og
  /// `title` er tom. Eldre varsler har vanlig tekst i `title`.
  titleKey           String?
  body               String?
  bodyKey            String?
  /// Verdier til {placeholder}-plassholdere i titleKey/bodyKey.
  params             Json?
  /// Menneskevennlig kilde, f.eks. «Oppdrag: testoppdrag · Biniam» eller
  /// «Kunde: Pipelife Norge AS». Frosset ved opprettelse slik at varselet
  /// fortsatt viser hvor det kom fra selv om oppdraget senere endres.
  sourceLabel        String?
  href               String?
  readAt             DateTime?
  /// Unik nøkkel per hendelse, slik at samme varsel ikke lages to ganger.
  dedupeKey          String?   @unique
  /// E-postkvittering: null betyr at varselet fortsatt venter på utsending.
  emailSentAt        DateTime?
  emailError         String?
  emailAttempts      Int       @default(0)
  emailNextAttemptAt DateTime  @default(now())
  /// Kort lease mens en instans sender e-posten, slik at flere instanser
  /// ikke sender samme varsel samtidig.
  emailLockedAt      DateTime?
  emailLockedBy      String?
  createdAt          DateTime  @default(now())

  pushMessages PushMessage[]

  @@index([userId, readAt, createdAt])
  @@index([createdAt])
  @@index([emailSentAt, emailNextAttemptAt])
}

/// Registrert mobilenhet for pushvarsler.
///
/// Tokenet er unikt per plattform. Samme fysiske enhet kan bytte eier etter en
/// ny innlogging: registreringen flytter da raden til den nye brukeren i
/// stedet for å lage en duplikat. Selve tokenet logges aldri.
model PushDevice {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// android | ios
  platform   String
  token      String
  appVersion String?
  /// Klientens stabile enhets-id, når appen oppgir den. Ikke et push-token.
  deviceId   String?
  active     Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  messages PushMessage[]

  @@unique([platform, token])
  @@index([userId, active])
  @@index([active, lastSeenAt])
  @@index([deviceId])
}

/// Vedvarende utboks for pushvarsler. Én rad per varsel og enhet, slik at
/// gjentatt innsetting er idempotent og en krasjet worker kan gjenoppta.
model PushMessage {
  id String @id @default(cuid())
  /// Stabil idempotensnøkkel, f.eks. «<notificationId>:<deviceId>».
  idempotencyKey String @unique

  notificationId String?
  notification   Notification? @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId String
  device   PushDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  /// Kopi av plattformen på køtidspunktet, slik at en senere enhetsendring
  /// ikke sender meldingen til feil leverandør.
  platform String
  /// Tittel/tekst brukes bare for testvarsler. Vanlige varsler slås opp fra
  /// Notification ved sending, med mottakerens språk.
  title  String?
  body   String?
  path   String?
  /// PENDING | SENDING | SENT | SKIPPED | FAILED | DEAD_LETTER
  status String @default("PENDING")

  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lockedAt      DateTime?
  lockedBy      String?
  /// Stabil feilkode fra leverandøradapteret. Aldri rå leverandørtekst.
  errorCode     String?
  lastError     String?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
  @@index([deviceId, status])
  @@index([notificationId])
}

model NotificationPreference {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   String
  inApp  Boolean @default(true)
  email  Boolean @default(true)

  @@unique([userId, type])
}

enum EmailMessageStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

/// Vedvarende utboks for transaksjons-e-post.
///
/// Hendelser legger en rad i denne tabellen i stedet for å sende SMTP i
/// request-stien. Jobbworkeren henter én rad med `FOR UPDATE SKIP LOCKED`,
/// renderer malen og sender via den eksisterende SMTP-transporten. Raden er
/// idempotent på `idempotencyKey`, slik at et dobbeltklikk eller en gjentatt
/// hendelse aldri gir to e-poster.
model EmailMessage {
  id             String             @id @default(cuid())
  to             String
  subject        String
  /// Hendelsesnøkkelen, f.eks. `quoteSent` eller `bookingConfirmed`.
  template       String
  /// Maldata. Inneholder personopplysninger frem til sending; etter vellykket
  /// sending tømmes feltet fordi det ikke lenger trengs for retry.
  payload        Json
  locale         String             @default("nb")
  status         EmailMessageStatus @default(PENDING)
  attempts       Int                @default(0)
  nextAttemptAt  DateTime           @default(now())
  /// Kort, PII-fri feilkode (f.eks. `ECONNECTION`). Aldri rå SMTP-melding.
  lastError      String?
  /// Unik nøkkel per hendelse/mottaker. Gjør enqueue idempotent.
  idempotencyKey String             @unique
  /// Kort lease mens en instans sender, så en krasjet prosess kan ryddes.
  lockedAt       DateTime?
  createdAt      DateTime           @default(now())
  sentAt         DateTime?

  @@index([status, nextAttemptAt])
  @@index([status, lockedAt])
  @@index([createdAt])
}

/// Globale innstillinger for transaksjons-e-post. Én rad med id "default".
/// Av/på per hendelsestype og avsender/reply-to. SMTP-hemmelighetene ligger
/// fortsatt i miljøvariabler og vises aldri her.
model EmailSettings {
  id               String   @id @default("default")
  fromName         String?
  fromAddress      String?
  replyTo          String?
  quoteSent        Boolean  @default(true)
  invoiceSent      Boolean  @default(true)
  paymentReceived  Boolean  @default(true)
  bookingRequested Boolean  @default(true)
  bookingConfirmed Boolean  @default(true)
  bookingCancelled Boolean  @default(true)
  workOrderAssigned Boolean @default(true)
  updatedAt        DateTime @default(now()) @updatedAt
  updatedById      String?
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  query     String
  /// Søkefiltre som JSON, slik at et lagret søk kan gjenopprettes eksakt.
  filters   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId, updatedAt])
}

/// Anonymisert nok for intern analyse, men beholder søketeksten slik at
/// nulltreff og populære søk kan forbedres. Søketeksten maskeres før lagring,
/// og raden har ingen kobling til brukeren som søkte.
model SearchLog {
  id              String   @id @default(cuid())
  query           String
  normalizedQuery String
  resultCount     Int
  latencyMs       Int
  filters         Json?
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([resultCount, createdAt])
  @@index([normalizedQuery, createdAt])
}

model Branding {
  id           String   @id @default(cuid())
  companyName  String   @default("Min Bedrift")
  logoUrl      String?
  primaryColor String   @default("#2563eb")
  updatedAt    DateTime @updatedAt
}

model Comment {
  id          String     @id @default(cuid())
  content     String
  authorName  String?
  workOrderId String?
  workOrder   WorkOrder? @relation("WorkOrderComments", fields: [workOrderId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     Contact?   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())

  @@index([workOrderId])
  @@index([customerId])
  @@index([contactId])
}

/// Globale kartinnstillinger. Én rad med id "default".
model MapSettings {
  id              String   @id @default("default")
  /// osm | maptiler | mapbox
  provider        String   @default("osm")
  /// API-nøkkel/token for leverandøren. Vises aldri i klientinnstillinger.
  apiKey          String?
  /// osm | topo | light | satellite
  defaultLayer    String   @default("osm")
  defaultZoom     Int      @default(6)
  centerLat       Float?
  centerLng       Float?
  scrollWheelZoom Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

/// Utgående og innkommende SMS.
///
/// Utgående rader er den vedvarende køen: `QUEUED` → `SENDING` → `SENT`/
/// `DELIVERED`, eller `DEAD_LETTER` etter tre mislykkede forsøk. Innkommende
/// webhook-leveranser lagres også her, med `direction = INBOUND`, slik at
/// `@@unique([provider, providerId])` gjør gjentatt levering idempotent.
model SmsMessage {
  id             String    @id @default(cuid())
  direction      String    @default("OUTBOUND")
  /// console | linkmobility | pswincom | twilio
  provider       String    @default("console")
  providerId     String?
  to             String
  from           String?
  body           String
  templateKey    String?
  locale         String?
  /// QUEUED | SENDING | SENT | DELIVERED | FAILED | DEAD_LETTER | RECEIVED
  status         String    @default("QUEUED")
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  lastError      String?
  workOrderId    String?
  contactId      String?
  userId         String?
  departmentId   String?
  threadId       String?
  createdAt      DateTime  @default(now())
  sentAt         DateTime?
  deliveredAt    DateTime?
  deadLetteredAt DateTime?

  workOrder  WorkOrder?     @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  contact    Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  user       User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  department Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  thread     MessageThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)

  @@unique([provider, providerId])
  @@index([status, nextAttemptAt])
  @@index([status, createdAt])
  @@index([contactId, createdAt])
  @@index([workOrderId, createdAt])
  @@index([threadId, createdAt])
}

/// Én samtale mellom kunden og kontoret. `threadKey` er en stabil, beregnet
/// nøkkel (kunde + kontakt + eventuelt oppdrag), slik at to samtidige
/// innkommende meldinger ikke lager hver sin tråd.
model MessageThread {
  id            String      @id @default(cuid())
  threadKey     String      @unique
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  workOrderId   String?
  workOrder     WorkOrder?  @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  contactId     String?
  contact       Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  subject       String?
  /// Antall innkommende meldinger kontoret ennå ikke har lest.
  unreadCount   Int         @default(0)
  lastMessageAt DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  messages    Message[]
  smsMessages SmsMessage[]

  @@index([customerId, lastMessageAt])
  @@index([departmentId, lastMessageAt])
  @@index([workOrderId])
  @@index([contactId])
}

/// En melding i en tråd, uavhengig av kanal. Innkommende SMS har også en
/// `SmsMessage`-rad for idempotens; `smsMessageId` peker på den.
model Message {
  id           String        @id @default(cuid())
  threadId     String
  thread       MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  /// INBOUND | OUTBOUND
  direction    String
  /// SMS | PORTAL | EMAIL
  channel      String        @default("SMS")
  body         String
  authorUserId String?
  author       User?         @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  smsMessageId String?
  fromAddress  String?
  toAddress    String?
  readAt       DateTime?
  createdAt    DateTime      @default(now())

  @@index([threadId, createdAt])
  @@index([smsMessageId])
  @@index([authorUserId])
}

/// Samtykke og reservasjon per kanal. En rad med `optedIn = true` og
/// `optedOut = false` er den eneste tilstanden som tillater utsending.
/// Manglende rad betyr «ukjent» og blokkerer SMS.
model ChannelPreference {
  id          String    @id @default(cuid())
  contactId   String?
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId  String?
  /// SMS | EMAIL | PORTAL
  channel     String    @default("SMS")
  optedIn     Boolean   @default(false)
  optedOut    Boolean   @default(false)
  consentedAt DateTime?
  optedOutAt  DateTime?
  source      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([contactId, channel])
  @@unique([userId, channel])
  @@index([customerId, channel])
}

/// Redigerbar SMS-mal per hendelse og språk. `variables` er den eksplisitte
/// listen over {plassholdere} malen kan bruke.
model SmsTemplate {
  id        String   @id @default(cuid())
  eventKey  String
  locale    String   @default("nb")
  body      String
  variables String[] @default([])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventKey, locale])
  @@index([eventKey, isActive])
}

/// Globale SMS-innstillinger. Én rad med id "default". Leverandør og
/// avsendernavn kommer fra miljøet og vises bare lesbart i UI-en.
model SmsSetting {
  id             String   @id @default("default")
  defaultLocale  String   @default("nb")
  optOutKeywords String[] @default(["STOP", "STOPP", "MELD AV", "AVMELD", "UNSUBSCRIBE"])
  optInKeywords  String[] @default(["START", "JA", "MELD PÅ", "PÅMELD", "SUBSCRIBE"])
  /// 0 eller null betyr ingen månedlig grense.
  monthlyCap     Int?     @default(0)
  updatedAt      DateTime @updatedAt
}

/// Automatisk påminnelse før en visit. Én rad per avdeling, kanal og
/// offset, slik at kontoret kan ha både 24-timers- og 2-timersvarsel.
/// Reglene redigeres under Innstillinger → SMS/påminnelser.
model ReminderRule {
  id          String @id @default(cuid())
  departmentId String
  department  Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  /// SMS | EMAIL | BOTH
  channel     String @default("SMS")
  /// Antall timer før visiten påminnelsen skal sendes.
  offsetHours Int    @default(24)
  /// Hendelsesmalen som brukes for SMS. E-post har egne innebygde tekster.
  templateKey String @default("VISIT_REMINDER")
  /// Stille timer i avdelingens tidssone. null betyr ingen stille periode.
  quietStartHour Int?
  quietEndHour   Int?
  timezone    String @default("Europe/Oslo")
  /// Øvre grense for antall påminnelser per visit på tvers av reglene.
  maxPerVisit Int    @default(2)
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dispatches ReminderDispatch[]

  @@unique([departmentId, channel, offsetHours])
  @@index([departmentId, isActive])
}

/// Vedvarende utsendelseslogg for påminnelser. `dedupeKey` gjør at samme
/// regel, visit og starttid aldri planlegges to ganger, også når flere
/// appinstanser kjører sveipet samtidig. `visitStartsAt` er frosset slik at
/// en flyttet eller avlyst visit kan avvises før utsending.
model ReminderDispatch {
  id            String   @id @default(cuid())
  ruleId        String
  rule          ReminderRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  visitId       String
  visit         Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  workOrderId   String?
  customerId    String?
  contactId     String?
  /// SMS | EMAIL
  channel       String
  offsetHours   Int
  locale        String   @default("nb")
  /// SCHEDULED | PROCESSING | SENT | SKIPPED | FAILED
  status        String   @default("SCHEDULED")
  scheduledFor  DateTime
  visitStartsAt DateTime
  sentAt        DateTime?
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  lastError     String?
  skipReason    String?
  smsMessageId  String?
  dedupeKey     String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([status, scheduledFor])
  @@index([visitId, status])
  @@index([departmentId, createdAt])
}

/// Installasjonsnivåmoduler. Én rad per modulnøkkel. Data i modulens tabeller
/// beholdes når modulen slås av; raden styrer bare om kode, sider, API-er og
/// arbeidsjobber er tilgjengelige. Kjernen (`core`) har alltid enabled=true.
model ModuleState {
  key       String   @id
  enabled   Boolean  @default(true)
  updatedAt DateTime @default(now()) @updatedAt
  updatedBy String?
}

// ---------------------------------------------------------------------------
// Tilbud og fakturering (modulene `quotes` og `invoicing`)
//
// Modellene er bevisst selvstendige: en faktura kan peke på et tilbud, et
// oppdrag eller en rapport, men beløpene ligger alltid lagret på fakturaen.
// Det gjør historikken lesbar selv om kilden senere endres.
// ---------------------------------------------------------------------------

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CREDITED
}

/// Hvordan en betaling ble mottatt. `ONLINE` er en betaling bekreftet av en
/// betalingsleverandør (PSP); kortdata lagres aldri i systemet.
enum PaymentMethod {
  BANK_TRANSFER
  CASH
  OTHER
  ONLINE
}

/// Tilstanden til fakturaens betalingslenke. `NONE` betyr at ingen lenke er
/// opprettet. Selve betalingen registreres som en `Payment` når webhooken
/// bekrefter den.
enum PaymentLinkStatus {
  NONE
  PENDING
  PAID
  PARTIALLY_PAID
  FAILED
  EXPIRED
}

/// Ett tilbud med linjer og en revisjonshistorikk. Versjonen økes hver gang
/// tilbudet sendes eller klones, slik at kunden alltid kan knyttes til en
/// bestemt utgave.
model Quote {
  id      String      @id @default(cuid())
  /// Menneskelig tilbudsnummer. Tildeles når tilbudet opprettes.
  quoteNumber String?  @unique
  title       String
  status      QuoteStatus @default(DRAFT)
  version     Int         @default(1)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// Navn som brukes dersom tilbudet ikke er knyttet til en kundekort ennå.
  /// Konvertering oppretter da kunden.
  customerName String?
  contactId    String?
  contact      Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  workOrderId String?
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  contractId  String?
  contract    Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  /// Utstyret tilbudet gjelder. Kobles til oppdraget ved konvertering.
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  currency String @default("NOK")
  subtotal Decimal @db.Decimal(12, 2) @default(0)
  vatTotal Decimal @db.Decimal(12, 2) @default(0)
  total    Decimal @db.Decimal(12, 2) @default(0)
  vatRate  Decimal @db.Decimal(5, 2) @default(25)

  validUntil DateTime? @db.Date
  notes      String?

  createdById   String?
  createdByName String?

  /// Portalgodkjenning. Bare SHA-256-hashen lagres. Tokenet er kortlivet og
  /// kan brukes én gang.
  tokenHash      String?   @unique
  tokenExpiresAt DateTime?
  tokenUsedAt    DateTime?

  sentAt         DateTime?
  acceptedAt     DateTime?
  rejectedAt     DateTime?
  rejectedReason String?

  /// Satt når et akseptert tilbud er konvertert til oppdrag. Unik hindrer at
  /// to samtidige konverteringer lager hvert sitt oppdrag.
  convertedWorkOrderId String?   @unique
  convertedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  lines    QuoteLine[]
  versions QuoteVersion[]
  invoices Invoice[]

  @@index([customerId])
  @@index([departmentId])
  @@index([status])
  @@index([validUntil])
  @@index([workOrderId])
  @@index([createdAt])
}

model QuoteLine {
  id          String @id @default(cuid())
  quoteId     String
  quote       Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  sortOrder   Int    @default(0)
  description String
  quantity    Decimal @db.Decimal(12, 2) @default(1)
  unit        String  @default("stk")
  unitPrice   Decimal @db.Decimal(12, 2) @default(0)
  vatRate     Decimal @db.Decimal(5, 2) @default(25)
  lineTotal   Decimal @db.Decimal(12, 2) @default(0)
  lineVat     Decimal @db.Decimal(12, 2) @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([quoteId, sortOrder])
}

/// Uforanderlig snapshot av et tilbud ved innsending eller kloning. Linjene
/// ligger i JSON fordi historikken skal være lesbar uten å følge relasjoner.
model QuoteVersion {
  id             String      @id @default(cuid())
  quoteId        String
  quote          Quote       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  version        Int
  status         QuoteStatus
  title          String
  snapshotJson   String
  subtotal       Decimal @db.Decimal(12, 2)
  vatTotal       Decimal @db.Decimal(12, 2)
  total          Decimal @db.Decimal(12, 2)
  vatRate        Decimal @db.Decimal(5, 2)
  validUntil     DateTime? @db.Date
  notes          String?
  createdById    String?
  createdByName  String?
  createdAt      DateTime @default(now())

  @@unique([quoteId, version])
  @@index([quoteId, createdAt])
}

model Invoice {
  id            String        @id @default(cuid())
  /// Tildeles når fakturaen sendes. Unik på tvers av installasjonen.
  invoiceNumber String?       @unique
  status        InvoiceStatus @default(DRAFT)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  contactId  String?
  contact    Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  workOrderId String?
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  reportId    String?
  report      Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  quoteId     String?
  quote       Quote? @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  currency String @default("NOK")
  subtotal    Decimal @db.Decimal(12, 2) @default(0)
  vatTotal    Decimal @db.Decimal(12, 2) @default(0)
  total       Decimal @db.Decimal(12, 2) @default(0)
  paidTotal   Decimal @db.Decimal(12, 2) @default(0)
  creditedTotal Decimal @db.Decimal(12, 2) @default(0)
  outstanding Decimal @db.Decimal(12, 2) @default(0)
  vatRate     Decimal @db.Decimal(5, 2) @default(25)

  /// Betalingslenke opprettet hos PSP. Bare URL og leverandørens id lagres –
  /// aldri kortdata eller hemmeligheter. `paymentStatus` speiler lenkens
  /// tilstand, ikke fakturaens bokføring.
  paymentProvider    String?
  paymentLinkId      String?
  paymentLinkUrl     String?
  paymentStatus      PaymentLinkStatus @default(NONE)
  paymentLinkCreatedAt DateTime?
  paymentLinkUpdatedAt DateTime?

  issueDate DateTime? @db.Date
  dueDate   DateTime? @db.Date
  notes     String?

  sentAt     DateTime?
  paidAt     DateTime?
  creditedAt DateTime?
  createdById   String?
  createdByName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  lines       InvoiceLine[]
  payments    Payment[]
  creditNotes CreditNote[]
  accountingSyncs AccountingSync[]

  @@index([customerId])
  @@index([departmentId])
  @@index([status])
  @@index([dueDate])
  @@index([workOrderId])
  @@index([quoteId])
  @@index([createdAt])
  @@index([paymentProvider, paymentLinkId])
  @@index([paymentStatus])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sortOrder   Int     @default(0)
  description String
  quantity    Decimal @db.Decimal(12, 2) @default(1)
  unit        String  @default("stk")
  unitPrice   Decimal @db.Decimal(12, 2) @default(0)
  vatRate     Decimal @db.Decimal(5, 2) @default(25)
  lineTotal   Decimal @db.Decimal(12, 2) @default(0)
  lineVat     Decimal @db.Decimal(12, 2) @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([invoiceId, sortOrder])
}

model Payment {
  id        String        @id @default(cuid())
  invoiceId String
  invoice   Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Decimal       @db.Decimal(12, 2)
  paidAt    DateTime      @db.Date
  method    PaymentMethod @default(BANK_TRANSFER)
  reference String?
  note      String?
  /// Klientens idempotensnøkkel. Samme nøkkel på samme faktura gir samme
  /// betalingsrad, aldri et dobbeltbeløp.
  idempotencyKey String?
  createdById    String?
  /// PSP-metadata. `providerEventId` er leverandørens hendelses-id;
  /// `providerReference` er betalingens id hos leverandøren. Begge er
  /// idempotensgrunnlag og inneholder aldri kortdata.
  provider          String?
  providerEventId   String?
  providerReference String?
  createdAt      DateTime @default(now())

  @@unique([invoiceId, idempotencyKey])
  @@unique([provider, providerEventId])
  @@index([invoiceId, paidAt])
  @@index([provider, providerReference])
  accountingPayments AccountingPayment[]
}

model CreditNote {
  id               String  @id @default(cuid())
  creditNoteNumber String  @unique
  invoiceId        String
  invoice          Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount           Decimal @db.Decimal(12, 2)
  vatAmount        Decimal @db.Decimal(12, 2)
  total            Decimal @db.Decimal(12, 2)
  reason           String?
  issuedAt         DateTime @db.Date
  createdById      String?
  createdByName    String?
  createdAt        DateTime @default(now())

  @@index([invoiceId, issuedAt])
}

/// Én rad med faktureringsinnstillinger. MVA-satsen er redigerbar, men
/// beløpene på en faktura fryses når den sendes.
model BillingSettings {
  id                  String @id @default("default")
  vatRate             Decimal @db.Decimal(5, 2) @default(25)
  invoiceDueDays      Int     @default(14)
  quoteValidityDays   Int     @default(30)
  approvalTokenTtlHours Int   @default(72)
  invoicePrefix       String  @default("F")
  nextInvoiceNumber   Int     @default(1)
  creditNotePrefix    String  @default("K")
  nextCreditNoteNumber Int    @default(1)
  updatedAt           DateTime @default(now()) @updatedAt
  updatedById         String?
}

// ---------------------------------------------------------------------------
// Betaling (PSP) og regnskap
// ---------------------------------------------------------------------------

/// Status for en regnskapssynk. `EXPORTED` brukes av CSV-fallbacken: filen er
/// laget lokalt og er ikke skrevet til et eksternt system.
enum AccountingSyncStatus {
  PENDING
  SYNCED
  EXPORTED
  FAILED
  SKIPPED
}

/// Installasjonsnivå for regnskapsintegrasjonen. Selve leverandøren og
/// hemmelighetene kommer fra miljøet; raden styrer om synk er slått på og
/// husker siste test/synk for administratorpanelet.
model AccountingSettings {
  id            String @id @default("default")
  provider      String @default("csv")
  enabled       Boolean @default(false)
  lastTestedAt  DateTime?
  lastTestOk    Boolean?
  lastTestError String?
  lastSyncAt    DateTime?
  lastSyncError String?
  updatedAt     DateTime @default(now()) @updatedAt
  updatedById   String?
}

/// Kobling mellom en kunde i FSM og samme kunde hos regnskapsleverandøren.
/// Unik per leverandør, slik at en ny synk gjenbruker ekstern id.
model AccountingCustomer {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  provider   String
  externalId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([customerId, provider])
  @@index([provider, externalId])
}

/// Tilstand for én faktura hos én regnskapsleverandør. `idempotencyKey` er
/// stabil per faktura/leverandør, slik at gjentatte synkeforsøk gjenbruker
/// raden i stedet for å lage et nytt eksternt dokument.
model AccountingSync {
  id        String @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  provider  String
  status    AccountingSyncStatus @default(PENDING)
  idempotencyKey String @unique

  externalCustomerId    String?
  externalInvoiceId     String?
  externalInvoiceNumber String?

  attemptCount  Int       @default(0)
  lastAttemptAt DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  payments AccountingPayment[]

  @@unique([invoiceId, provider])
  @@index([provider, status])
  @@index([lastAttemptAt])
}

/// Betalingssynk per betalingsrad. Idempotensnøkkelen hindrer at samme
/// betaling bokføres to ganger hos regnskapsleverandøren.
model AccountingPayment {
  id         String @id @default(cuid())
  syncId     String
  sync       AccountingSync @relation(fields: [syncId], references: [id], onDelete: Cascade)
  paymentId  String?
  payment    Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  provider   String
  status     AccountingSyncStatus @default(PENDING)
  idempotencyKey String @unique
  externalId String?
  attemptCount Int @default(0)
  lastAttemptAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([syncId, paymentId])
  @@index([provider, status])
}

// ---------------------------------------------------------------------------
// OPS-05: Lager og reservedeler
// ---------------------------------------------------------------------------

/// Fysisk lager eller montørbil. Bil-lokasjoner kan knyttes til en bruker, slik
/// at montøren ser eget lagerbeholdning i felt.
enum InventoryLocationType {
  WAREHOUSE
  VAN
}

enum StockMovementType {
  IN
  OUT
  ADJUST
  RESERVE
  RELEASE
  CONSUME
}

enum InventoryReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model InventoryLocation {
  id   String                @id @default(cuid())
  name String
  type InventoryLocationType @default(WAREHOUSE)

  /// Avdelingen lokasjonen tilhører. Avdelingssperren gjenbruker samme
  /// prinsipp som oppdrag: ansatte ser bare egen avdeling.
  departmentId String?
  /// Satt for montørbiler der en bestemt bruker er ansvarlig.
  assignedUserId String?
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  stockLevels  StockLevel[]
  movements    StockMovement[]
  reservations InventoryReservation[]
  purchaseOrders PurchaseOrder[]

  @@index([departmentId])
  @@index([assignedUserId])
  @@index([isActive])
}

model InventoryItem {
  id          String  @id @default(cuid())
  sku         String  @unique
  name        String
  unit        String  @default("stk")
  /// Bestillingspunkt. Når tilgjengelig beholdning faller under dette nivået
  /// lager tjenestelaget et kjøpsforslag; ingen egen tabell er nødvendig.
  minLevel    Decimal @default(0) @db.Decimal(12, 3)
  active      Boolean @default(true)
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  stockLevels  StockLevel[]
  movements    StockMovement[]
  reservations InventoryReservation[]
  purchaseOrderLines PurchaseOrderLine[]

  @@index([active])
  @@index([name])
}

model StockLevel {
  id         String @id @default(cuid())
  itemId     String
  item       InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  locationId String
  location   InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  quantity   Decimal @default(0) @db.Decimal(12, 3)

  updatedAt DateTime @default(now()) @updatedAt

  @@unique([itemId, locationId])
  @@index([itemId])
  @@index([locationId])
}

/// Alle beholdningsendringer er sporet. `quantity` er positiv for IN/OUT/
/// RESERVE/RELEASE/CONSUME, mens ADJUST lagrer den signerte differansen.
model StockMovement {
  id         String            @id @default(cuid())
  itemId     String
  item       InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  locationId String
  location   InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  type       StockMovementType
  quantity   Decimal           @db.Decimal(12, 3)
  reason     String?

  workOrderId  String?
  visitId      String?
  userId       String?
  reservationId String?

  createdAt DateTime @default(now())

  @@index([itemId, createdAt])
  @@index([locationId, createdAt])
  @@index([workOrderId])
  @@index([visitId])
}

/// Reservert mengde mot et oppdrag eller en arbeidsøkt. Reservasjonen holder
/// ikke tilbake fysisk vare før den forbrukes, men reduserer tilgjengelig
/// beholdning og hindrer at to montører reserverer samme del.
model InventoryReservation {
  id         String                     @id @default(cuid())
  itemId     String
  item       InventoryItem              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  locationId String
  location   InventoryLocation          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  quantity   Decimal                    @db.Decimal(12, 3)
  status     InventoryReservationStatus @default(ACTIVE)

  workOrderId String?
  visitId     String?
  createdById String?
  note        String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  releasedAt DateTime?
  consumedAt DateTime?

  @@index([itemId, status])
  @@index([locationId, status])
  @@index([workOrderId, status])
  @@index([visitId, status])
}

/// Leverandør for innkjøp. `departmentId` er valgfri: en leverandør uten
/// avdeling er felles for hele installasjonen, mens en avdelingsleverandør
/// bare er synlig for den avdelingen.
model Supplier {
  id           String  @id @default(cuid())
  name         String
  orgNumber    String?
  email        String?
  phone        String?
  departmentId String?
  active       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  purchaseOrders PurchaseOrder[]

  @@unique([departmentId, name])
  @@index([departmentId])
  @@index([orgNumber])
  @@index([active])
}

/// Innkjøpsordre. Nummeret er menneskelig og tildeles av tjenestelaget fra en
/// PostgreSQL-sekvens, slik at to samtidige opprettelser aldri kolliderer.
/// `departmentId` fryses fra mottakslokasjonen og styrer avdelingssperren.
model PurchaseOrder {
  id     String              @id @default(cuid())
  number String              @unique
  status PurchaseOrderStatus @default(DRAFT)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  /// Lokasjonen varene skal mottas på. Beholdningen økes her ved mottak.
  locationId String
  location   InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  departmentId String?

  expectedAt DateTime? @db.Date
  notes      String?

  createdById String?
  receivedAt  DateTime?
  orderedAt   DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  lines PurchaseOrderLine[]

  @@index([status])
  @@index([supplierId])
  @@index([locationId])
  @@index([departmentId, status])
  @@index([createdAt])
}

/// Én varelinje per innkjøpsordre. Summer beregnes på lesetid; verken
/// linjebeløp eller ordretotal lagres, slik at en klient aldri kan sende inn
/// et avvikende beløp.
model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  orderedQuantity  Decimal @db.Decimal(12, 3)
  receivedQuantity Decimal @default(0) @db.Decimal(12, 3)
  unitCost         Decimal @default(0) @db.Decimal(12, 2)
  sortOrder        Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([purchaseOrderId, inventoryItemId])
  @@index([inventoryItemId])
  @@index([purchaseOrderId, sortOrder])
}

// ---------------------------------------------------------------------------
// FLD-01: Kjøreturer, utlegg og lønnsgrunnlag
// ---------------------------------------------------------------------------

enum MileageStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum ExpenseStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum PayrollLineKind {
  WORK
  TRAVEL
  MILEAGE
  EXPENSE
}

/// Kjøretur registrert av montøren. `amount` beregnes alltid av tjenestelaget
/// som `km × rate` avrundet til øre, slik at klienten ikke kan sende et avvik.
model MileageTrip {
  id           String        @id @default(cuid())
  userId       String
  departmentId String?
  workOrderId  String?
  visitId      String?

  date        DateTime @db.Date
  fromAddress String
  toAddress   String
  km          Decimal  @db.Decimal(10, 2)
  rate        Decimal  @db.Decimal(10, 4)
  amount      Decimal  @db.Decimal(12, 2)
  purpose     String?

  status          MileageStatus @default(PENDING)
  submittedAt     DateTime?
  approvedAt      DateTime?
  approvedById    String?
  rejectionReason String?

  /// Settes når turen er med i en låst lønnsperiode. Da kan den ikke eksporteres
  /// på nytt i en overlappende periode.
  payrollExportId String?
  exportedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId, date])
  @@index([departmentId, status])
  @@index([workOrderId])
  @@index([visitId])
  @@index([payrollExportId])
}

/// Utlegg med kvittering. `amount` er bruttobeløp inkl. mva, og `vatAmount` er
/// mva-delen. Lønnsgrunnlaget bruker beløpet slik det står på kvitteringen.
model Expense {
  id           String        @id @default(cuid())
  userId       String
  departmentId String?
  workOrderId  String?

  date        DateTime @db.Date
  category    String
  description String?
  amount      Decimal  @db.Decimal(12, 2)
  vatAmount   Decimal  @default(0) @db.Decimal(12, 2)

  /// Enten en fil fra den eksisterende opplastingsruten (`/uploads/...`) eller
  /// et dokument i dokumentbiblioteket. Begge valideres av tjenestelaget.
  receiptUrl  String?
  documentId  String?

  status          ExpenseStatus @default(PENDING)
  submittedAt     DateTime?
  approvedAt      DateTime?
  approvedById    String?
  rejectionReason String?

  payrollExportId String?
  exportedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId, date])
  @@index([departmentId, status])
  @@index([workOrderId])
  @@index([payrollExportId])
}

/// Låst lønnsperiode. Raden gjør eksporten idempotent: samme avdeling og
/// periode returnerer nøyaktig samme CSV, og overlappende perioder avvises.
model PayrollExport {
  id           String @id @default(cuid())
  departmentId String
  periodStart  DateTime @db.Date
  periodEnd    DateTime @db.Date
  createdById  String
  checksum     String
  rowCount     Int
  csvText      String

  createdAt DateTime @default(now())

  lines PayrollExportLine[]

  @@unique([departmentId, periodStart, periodEnd])
  @@index([departmentId, createdAt])
}

model PayrollExportLine {
  id       String        @id @default(cuid())
  exportId String
  export   PayrollExport @relation(fields: [exportId], references: [id], onDelete: Cascade)
  kind     PayrollLineKind

  /// Stabil referanse innenfor eksporten: bruker+dato for tid, ellers rad-id.
  refId       String
  userId      String
  userName    String
  workOrderId String?
  occurredOn  DateTime @db.Date
  description String?
  quantity    Decimal  @db.Decimal(12, 3)
  unit        String
  amount      Decimal  @default(0) @db.Decimal(12, 2)
  vatAmount   Decimal  @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@unique([exportId, kind, refId])
  @@index([exportId])
}
