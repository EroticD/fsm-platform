generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Tilkoblingsadressen settes i prisma.config.mjs (Prisma 7). Klienten får
  // den via driver-adapteren i src/lib/prisma.ts.
}

// Avdelingene avgjør hvilke oppdrag en ansatt kan se. Kunder, dokumenter og
// rapporter er felles for alle avdelinger, mens oppdrag er avdelingssperret.
model Department {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)
  /// Standardavdeling for kundebestillinger og nye oppdrag uten valgt avdeling.
  isDefault   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  workOrders WorkOrder[]
  contracts  Contract[]

  @@index([isActive])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("TECHNICIAN")

  password         String?
  resetToken       String?
  resetTokenExpiry DateTime?

  isTwoFactorEnabled Boolean @default(false)
  twoFactorSecret    String?

  // Konto må aktiveres manuelt av en administrator før innlogging er tillatt
  isActive Boolean @default(false)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  // Kundeportalbrukere kobles til en kontaktperson på kundekortet
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  // Ansatte tilhører en avdeling. Kundeportalbrukere kan stå uten.
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  // Ekstra rettigheter utover rollens standardnivå. Sletting er ikke en
  // rettighet her; det er alltid forbeholdt administrator.
  permissions String[] @default([])

  workOrders WorkOrder[] @relation("WorkOrderTechnicians")

  @@index([departmentId])
}

model Customer {
  id             String  @id @default(cuid())
  name           String
  customerNumber String?
  orgNumber      String?
  brandColor     String?
  logoUrl        String?

  address    String?
  postalCode String?
  city       String?
  phone      String?
  email      String?
  notes      String?

  products    Product[]
  contracts   Contract[]
  workOrder   WorkOrder[]
  contacts    Contact[]
  comments    Comment[]
  attachments CustomerAttachment[]

  users User[]

  @@index([email])
  @@index([orgNumber])
}

model Contact {
  id    String  @id @default(cuid())
  name  String
  email String?
  phone String?
  role  String?

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  workOrder WorkOrder[]
  comments  Comment[]
  users     User[]
  contracts Contract[]
}

// En enhet er en maskin/utstyr som står hos kunden, f.eks. en port, en pumpe
// eller et aggregat. Kunden kan ha mange enheter.
model Product {
  id           String  @id @default(cuid())
  model        String
  serialNumber String?
  location     String?

  customerId  String
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  workOrder   WorkOrder[]
  reportUnits ReportUnit[]

  @@index([customerId])
}

// En serviceavtale beskriver en gjentagende service for en kunde. Hver gang
// neste service faller forfaller, opprettes et nytt oppdrag med kundedataene
// ferdig utfylt. Sjekklisten er en mal som festes til oppdraget, men selve
// rapporten er alltid ny og tom – den forrige rapporten legges ved som PDF.
model Contract {
  id              String   @id @default(cuid())
  title           String
  /// Intervall i måneder. Bare 3, 6, 12 og 24 er gyldige.
  intervalMonths  Int
  startDate       DateTime
  /// Neste dato det skal opprettes et oppdrag for.
  nextServiceDate DateTime
  isActive        Boolean  @default(true)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  // Avtalen eier avdelingen som de genererte oppdragene havner i.
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  // Kontaktpersonen som skal stå på de genererte oppdragene. Tom betyr at
  // kundens første kontaktperson brukes.
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  // Sjekklistemalen som festes til hvert genererte oppdrag.
  templateId String?
  template   Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  workOrders WorkOrder[]

  @@index([customerId])
  @@index([departmentId])
  @@index([nextServiceDate])
}

model CustomerAttachment {
  id        String   @id @default(cuid())
  fileName  String
  dataUrl   String
  createdAt DateTime @default(now())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

enum WorkStatus {
  PLANNED
  IN_PROGRESS
  WAITING
  COMPLETED
  PENDING
  CANCELLED
  OPEN
}

model WorkOrder {
  id           String     @id @default(cuid())
  title        String
  description  String?
  scheduledFor DateTime?
  /// Siste dag oppdraget varer (inklusiv). Tom betyr éndagsoppdrag.
  scheduledTo  DateTime?
  status       WorkStatus @default(PLANNED)
  creatorName  String?

  technicians User[] @relation("WorkOrderTechnicians")

  // Oppdraget tilhører én avdeling, og er bare synlig for ansatte der.
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  comments    JobComment[]
  attachments Attachment[]

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  // Satt når oppdraget er generert fra en serviceavtale.
  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  templates    Template[] @relation("WorkOrderTemplates")
  reports      Report[]
  workComments Comment[]  @relation("WorkOrderComments")
  tags         Tag[]      @relation("WorkOrderTags")

  @@index([departmentId])
  @@index([customerId])
  @@index([status])
  @@index([scheduledFor])
  @@index([contractId])
}

model Tag {
  id         String      @id @default(cuid())
  name       String      @unique
  color      String      @default("#3b82f6")
  workOrders WorkOrder[] @relation("WorkOrderTags")
}

model DocumentTag {
  id        String     @id @default(cuid())
  name      String     @unique
  color     String     @default("#3b82f6")
  documents Document[] @relation("DocumentTagRelation")
}

model DocumentFolder {
  id        String           @id @default(cuid())
  name      String
  parentId  String?
  parent    DocumentFolder?  @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  DocumentFolder[] @relation("FolderChildren")
  documents Document[]

  @@index([parentId])
}

model Document {
  id          String  @id @default(cuid())
  title       String
  description String?
  fileName    String
  filePath    String
  fileSize    Int     @default(0)
  mimeType    String  @default("application/pdf")

  // Ekstrahert tekst fra PDF for fulltekst-søk. pageTexts er JSON-array
  // [{page: number, text: string}] for side-spesifikk navigasjon.
  contentText String?
  pageTexts   String?

  folderId String?
  folder   DocumentFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  tags DocumentTag[] @relation("DocumentTagRelation")

  uploadedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([folderId])
  @@index([title])
}

model Report {
  id          String   @id @default(cuid())
  dataJson    String
  comments    String?
  completedAt DateTime @default(now())

  // Signaturer. Tekniker og kunde signerer hver for seg, og begge er valgfrie
  // (en jobb kan signeres av bare én av partene).
  technicianSignatureUrl String?
  technicianName         String?
  customerSignatureUrl   String?
  customerName           String?

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  templateId String?
  template   Template? @relation(fields: [templateId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Rapporten låses automatisk når den er fylt ut, og kan ikke endres igjen før
  // en administrator låser den opp. Det hindrer at en signert rapport endres i
  // ettertid – noe som er viktig for sporbarheten.
  isLocked     Boolean   @default(false)
  lockedAt     DateTime?
  lockedByName String?

  units ReportUnit[]

  @@index([workOrderId])
}

// Én enhet som inngår i en rapport. Feltene er øyeblikksbilder av enheten slik
// den var da rapporten ble skrevet, slik at rapporten forblir lesbar selv om
// enheten endres eller slettes på kundekortet senere.
model ReportUnit {
  id           String  @id @default(cuid())
  label        String
  serialNumber String?
  location     String?

  // GODKJENT | AVVIK – samme verdier som hovedresultatet.
  status      String  @default("GODKJENT")
  answersJson String  @default("{}")
  comment     String?

  reportId String
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([reportId])
  @@index([productId])
}

model Template {
  id         String      @id @default(cuid())
  title      String
  fieldsJson String
  reports    Report[]
  workOrder  WorkOrder[] @relation("WorkOrderTemplates")
  contracts  Contract[]
}

model JobComment {
  id         String   @id @default(cuid())
  text       String
  authorName String
  createdAt  DateTime @default(now())

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
}

model Attachment {
  id       String @id @default(cuid())
  fileName String
  dataUrl  String

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  userName   String
  createdAt  DateTime @default(now())

  @@index([entityType])
  @@index([entityId])
}

model Branding {
  id           String   @id @default(cuid())
  companyName  String   @default("Min Bedrift")
  logoUrl      String?
  primaryColor String   @default("#2563eb")
  updatedAt    DateTime @updatedAt
}

model Comment {
  id          String     @id @default(cuid())
  content     String
  authorName  String?
  workOrderId String?
  workOrder   WorkOrder? @relation("WorkOrderComments", fields: [workOrderId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     Contact?   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())

  @@index([workOrderId])
  @@index([customerId])
  @@index([contactId])
}
